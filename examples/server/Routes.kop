// Routes.kop — kumpulan route contoh untuk server demo (v1.23).
// Dipakai ServerDemo (blocking) dan ServerEvent (event-loop poll).

import Bytes;
import Str;
import Time;
import HttpServer;
import Static;

class Routes {

    static int[] okText(int[] req, String body, int keep) {
        return HttpServer.responseFor(req, 200, "text/plain; charset=utf-8", body, keep);
    }

    static int[] handle(int[] req, int keep) {
        String p = HttpServer.path(req);

        if (p == "/") {
            return HttpServer.responseFor(req, 200, "text/html; charset=utf-8",
                                          "<h1>Kopi server</h1>\n", keep);
        }
        if (p == "/health") {
            return HttpServer.responseFor(req, 200, "text/plain; charset=utf-8",
                                          "ok\n", keep);
        }
        if (p == "/json") {
            return HttpServer.responseFor(req, 200, "application/json",
                                          "{\"status\":\"ok\",\"lang\":\"kopi\"}\n", keep);
        }
        if (p == "/time") {
            return okText(req, Time.format(Time.epoch()) + "\n", keep);
        }
        if (p == "/echo") {
            return okText(req, Net.mkstr(HttpServer.bodyAny(req)), keep);
        }
        if (p == "/sum") {
            int a = Str.toInt(HttpServer.queryValue(req, "a"));
            int b = Str.toInt(HttpServer.queryValue(req, "b"));
            return okText(req, Str.fromInt(a + b) + "\n", keep);
        }
        if (p == "/header") {
            String name = HttpServer.queryValue(req, "name");
            return okText(req, HttpServer.headerValue(req, name) + "\n", keep);
        }
        if (p == "/setcookie") {
            String extra = HttpServer.setCookie("sesi", "abc123", "/", 60);
            return HttpServer.respond(200, "text/plain; charset=utf-8",
                                      "cookie dipasang\n", extra, keep);
        }
        if (p == "/cookie") {
            return okText(req, "sesi=" + HttpServer.cookie(req, "sesi") + "\n", keep);
        }
        if (Str.startsWith(p, "/static/")) {
            String rel = Str.sub(p, 8, p.length - 8);
            return Static.serveKA(rel, keep);
        }
        return HttpServer.responseFor(req, 404, "text/plain; charset=utf-8",
                                      "not found\n", keep);
    }
}
