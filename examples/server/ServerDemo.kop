// ServerDemo.kop — server HTTP blocking sederhana (v1.10.0).
// Satu koneksi dilayani sampai selesai (keep-alive), lalu lanjut.
// Untuk banyak klien sekaligus lihat ServerEvent.kop (poll).
import Str;
import Log;
import HttpServer;
import Routes;

class Main {
    public static void main(String[] args) {
        int port = 8080;
        if (Net.argc() > 0) port = Str.toInt(Net.argv(0));

        int fd = Net.socket(2, 1);
        if (fd < 0) { Log.error("boot", "socket gagal"); return; }
        Net.setsockopt(fd, 1, 2, 1);
        if (Net.bind(fd, 0, port) < 0 || Net.listen(fd, 16) < 0) {
            Log.error("boot", "bind/listen gagal");
            return;
        }
        Log.info("boot", "Kopi server siap");

        while (true) {
            int c = Net.accept(fd);
            if (c < 0) { Net.sleep(5); continue; }
            while (true) {
                int mark = Net.memMark();
                int[] req = HttpServer.readRequest(c, 16384);
                if (req.length == 0) { Net.memReset(mark); break; }
                int keep = 0;
                if (HttpServer.keepAlive(req)) keep = 1;
                int[] resp = Routes.handle(req, keep);
                HttpServer.send(c, resp);
                Net.memReset(mark);
                if (keep == 0) break;
            }
            Net.close(c);
        }
    }
}
