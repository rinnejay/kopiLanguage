class Main {
    public static void main(String[] args) {
        for (int i = 0; i < 10; i = i + 1) {
            if (i == 3) { continue; }
            if (i > 6) { break; }
            System.out.println(i);
        }
        int j = 0;
        while (j < 100) {
            j = j + 5;
            if (j % 7 == 0) { break; }
        }
        System.out.println(j);
    }
}
