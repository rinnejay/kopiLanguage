import Conv;

class Csv {
    static int fields(int[] line) {
        int n = 1;
        for (int i = 0; i < line.length; i++) if (line[i] == 44) n++;
        return n;
    }
    static int[] fieldAt(int[] line, int idx) {
        int k = 0;
        int s = 0;
        for (int i = 0; i <= line.length; i++) {
            boolean end = i == line.length;
            boolean comma = false;
            if (!end && line[i] == 44) comma = true;
            if (end || comma) {
                if (k == idx) {
                    int[] o = new int[i - s];
                    for (int j = 0; j < o.length; j++) o[j] = line[s + j];
                    return o;
                }
                k++;
                s = i + 1;
            }
        }
        return new int[0];
    }
    static int totalInts(int[] line) {
        int s = 0;
        int n = fields(line);
        for (int i = 0; i < n; i++) s = s + Conv.atoi(fieldAt(line, i));
        return s;
    }
}
