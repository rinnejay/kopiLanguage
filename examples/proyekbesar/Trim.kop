import Case;

class Trim {
    static int[] trim(int[] s) {
        int a = 0;
        int b = s.length;
        while (a < b && s[a] == 32) a++;
        while (b > a && s[b - 1] == 32) b--;
        int[] o = new int[b - a];
        for (int i = 0; i < o.length; i++) o[i] = s[a + i];
        return o;
    }
    static int[] repeat(int[] s, int n) {
        if (n <= 0) return new int[0];
        int[] o = new int[s.length * n];
        int k = 0;
        for (int r = 0; r < n; r++)
            for (int i = 0; i < s.length; i++) { o[k] = s[i]; k++; }
        return o;
    }
}
