class SearchX {
    static int linear(int[] a, int v) {
        for (int i = 0; i < a.length; i++) if (a[i] == v) return i;
        return -1;
    }
    static int binary(int[] a, int v) {
        int lo = 0;
        int hi = a.length - 1;
        while (lo <= hi) {
            int m = lo + (hi - lo) / 2;
            if (a[m] == v) return m;
            if (a[m] < v) lo = m + 1;
            else hi = m - 1;
        }
        return -1;
    }
}
