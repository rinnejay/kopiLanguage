class BitOpsX {
    static int popcount(int n) {
        int c = 0;
        for (int i = 0; i < 32; i++) { c = c + (n & 1); n = n >>> 1; }
        return c;
    }
    static int reverseBits(int n) {
        int r = 0;
        for (int i = 0; i < 32; i++) { r = (r << 1) | (n & 1); n = n >>> 1; }
        return r;
    }
    static int highest(int n) {
        int p = -1;
        while (n > 0) { p++; n = n >>> 1; }
        return p;
    }
}
