import Bytes;

class Customer {
    static int find(int[] ids, int id) {
        for (int i = 0; i < ids.length; i++) if (ids[i] == id) return i;
        return -1;
    }
    static int tier(int total) {
        if (total >= 1000000) return 3;
        if (total >= 500000) return 2;
        if (total >= 100000) return 1;
        return 0;
    }
    static boolean valid(int id) { return id > 0; }
}
