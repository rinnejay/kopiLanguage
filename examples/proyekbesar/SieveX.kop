import MathX;

class SieveX {
    static int count(int n) {
        int c = 0;
        for (int i = 2; i <= n; i++) if (MathX.isPrime(i)) c++;
        return c;
    }
    static int sum(int n) {
        int s = 0;
        for (int i = 2; i <= n; i++) if (MathX.isPrime(i)) s = s + i;
        return s;
    }
}
