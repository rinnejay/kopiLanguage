class DpFib {
    static int iter(int n) {
        int a = 0;
        int b = 1;
        for (int i = 0; i < n; i++) { int c = a + b; a = b; b = c; }
        return a;
    }
    static int rec(int n) {
        if (n < 2) return n;
        return rec(n - 1) + rec(n - 2);
    }
    static int memo(int n) {
        int[] tab = new int[n + 1];
        for (int i = 0; i <= n; i++) tab[i] = -1;
        return mrec(n, tab);
    }
    static int mrec(int n, int[] tab) {
        if (n < 2) return n;
        if (tab[n] >= 0) return tab[n];
        int v = mrec(n - 1, tab) + mrec(n - 2, tab);
        tab[n] = v;
        return v;
    }
}
