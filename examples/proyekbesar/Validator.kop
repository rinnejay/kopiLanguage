import Case;

class Validator {
    static boolean sku(int[] s) {
        if (s.length < 3 || s.length > 16) return false;
        for (int i = 0; i < s.length; i++) {
            int c = s[i];
            if (!Case.isAlpha(c) && !Case.isDigit(c) && c != 45) return false;
        }
        return true;
    }
    static boolean qty(int q) { return q >= 0 && q <= 100000; }
    static int clampQty(int q) {
        if (q < 0) return 0;
        if (q > 100000) return 100000;
        return q;
    }
}
