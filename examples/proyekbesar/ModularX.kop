import MathX;

class ModularX {
    static int powmod(int a, int e, int m) { return MathX.modpow(a, e, m); }
    static int inv(int a, int m) {
        int g = gcdx(a, m);
        return g;
    }
    static int gcdx(int a, int m) {
        int g = MathX.gcd(a, m);
        if (g != 1) return -1;
        int x = 1;
        while ((a * x) % m != 1) x++;
        return x;
    }
}
