class MiniVm {
    static int run(int[] prog, int[] input) {
        int[] st = new int[256];
        int sp = 0;
        int pc = 0;
        int in = 0;
        while (pc < prog.length) {
            int op = prog[pc];
            pc++;
            if (op == 1) { st[sp] = prog[pc]; sp++; pc++; }
            else if (op == 2) { sp--; }
            else if (op == 3) { st[sp - 2] = st[sp - 2] + st[sp - 1]; sp--; }
            else if (op == 4) { st[sp - 2] = st[sp - 2] * st[sp - 1]; sp--; }
            else if (op == 5) { st[sp] = input[in]; in++; sp++; }
            else if (op == 6) { return st[sp - 1]; }
        }
        return 0;
    }
}
