import SortX;

class PermuteX {
    static boolean next(int[] a) {
        int i = a.length - 2;
        while (i >= 0 && a[i] >= a[i + 1]) i--;
        if (i < 0) return false;
        int j = a.length - 1;
        while (a[j] <= a[i]) j--;
        int t = a[i]; a[i] = a[j]; a[j] = t;
        int l = i + 1;
        int r = a.length - 1;
        while (l < r) { t = a[l]; a[l] = a[r]; a[r] = t; l++; r--; }
        return true;
    }
    static int count(int n) {
        int[] a = new int[n];
        for (int i = 0; i < n; i++) a[i] = i + 1;
        int c = 1;
        while (next(a)) c++;
        return c;
    }
}
