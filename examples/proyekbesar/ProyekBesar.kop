/* ProyekBesar.kop — proyek uji ketangguhan: 50+ modul saling import.
 * Dijalankan di VM & a64; deterministik (tanpa input luar). */

import ArraysX;
import Base64X;
import Billing;
import BitOpsX;
import BitsetX;
import Bytes;
import Case;
import Checksum;
import CipherX;
import CompilerX;
import Config;
import Conv;
import Crc;
import Csv;
import Customer;
import DijkstraX;
import DpFib;
import DpKnap;
import EvalX;
import EventBus;
import Fnv;
import GraphBfs;
import GraphDfs;
import HashX;
import HeapX;
import Inventory;
import Invoice;
import JsonX;
import KmpX;
import LexerX;
import ListX;
import LogX;
import MathX;
import MatrixX;
import Metrics;
import MiniVm;
import ModularX;
import Orders;
import PermuteX;
import Pipeline;
import QueueX;
import Report;
import RleX;
import Rng;
import Scheduler;
import SearchX;
import SieveX;
import SortX;
import StackX;
import StatsX;
import TextTable;
import Trim;
import Validator;

class Main {
    public static void main(String[] args) {
        int[] hello = Net.bytes("KOPI PROYEK BESAR");
        System.out.println(hello.length);
        System.out.println(Bytes.indexOf(hello, Net.bytes("PROYEK"), 0));
        System.out.println(Bytes.cmp(Net.bytes("abc"), Net.bytes("abd")));
        System.out.println(Conv.atoi(Net.bytes("-12345")));
        System.out.println(Conv.itoa(-987).length);
        System.out.println(Case.upper(Net.bytes("kopi"))[0]);
        System.out.println(Trim.trim(Net.bytes("  x  ")).length);
        System.out.println(Trim.repeat(Net.bytes("ab"), 3).length);
        System.out.println(Fnv.hash(hello));
        System.out.println(Crc.crc16(hello));
        System.out.println(Crc.adler(hello));
        int[] rng = Rng.make(12345);
        System.out.println(Rng.nextMod(rng, 100));
        System.out.println(Rng.nextMod(rng, 100));
        System.out.println(Base64X.enc(Net.bytes("kopi")).length);
        System.out.println(Conv.atoi(Base64X.dec(Base64X.enc(Net.bytes("kopi")))));
        System.out.println(MathX.gcd(84, 30));
        System.out.println(MathX.lcm(4, 6));
        System.out.println(MathX.modpow(2, 10, 1000));
        System.out.println(MathX.isqrt(10000));
        int[] raw = new int[8];
        raw[0] = 5; raw[1] = 3; raw[2] = 9; raw[3] = 1;
        raw[4] = 7; raw[5] = 2; raw[6] = 8; raw[7] = 4;
        int[] sorted = SortX.insertion(raw);
        System.out.println(sorted[0]);
        System.out.println(sorted[7]);
        System.out.println(SearchX.linear(raw, 7));
        System.out.println(SearchX.binary(sorted, 9));
        int[] st = new int[16];
        StackX.push(st, 10); StackX.push(st, 20); StackX.push(st, 30);
        System.out.println(StackX.pop(st));
        System.out.println(StackX.size(st));
        int[] q = new int[10];
        QueueX.push(q, 1); QueueX.push(q, 2); QueueX.push(q, 3);
        System.out.println(QueueX.pop(q));
        System.out.println(QueueX.size(q));
        int[] list = new int[20];
        ListX.append(list, 11); ListX.append(list, 22); ListX.append(list, 33);
        System.out.println(ListX.indexOf(list, 22));
        System.out.println(ListX.removeAt(list, 1));
        int[] heap = new int[20];
        HeapX.push(heap, 9); HeapX.push(heap, 4); HeapX.push(heap, 7); HeapX.push(heap, 1);
        System.out.println(HeapX.pop(heap));
        System.out.println(HeapX.pop(heap));
        int[] bits = new int[4];
        BitsetX.set(bits, 3); BitsetX.set(bits, 70);
        System.out.println(BitsetX.count(bits));
        int[] ma = new int[4]; ma[0] = 1; ma[1] = 2; ma[2] = 3; ma[3] = 4;
        int[] mb = new int[4]; mb[0] = 5; mb[1] = 6; mb[2] = 7; mb[3] = 8;
        int[] mc = MatrixX.mul(2, ma, mb);
        System.out.println(mc[0]);
        int[] m3 = new int[9];
        m3[0] = 2; m3[1] = 0; m3[2] = 1;
        m3[3] = 1; m3[4] = 3; m3[5] = 2;
        m3[6] = 1; m3[7] = 1; m3[8] = 4;
        System.out.println(MatrixX.det3(m3));
        int[] vals = new int[9];
        vals[0] = 4; vals[1] = 8; vals[2] = 15; vals[3] = 16; vals[4] = 23;
        vals[5] = 42; vals[6] = 7; vals[7] = 11; vals[8] = 19;
        System.out.println(StatsX.mean(vals));
        System.out.println(StatsX.median(vals));
        System.out.println(StatsX.max(vals));
        System.out.println(ArraysX.sum(vals));
        System.out.println(ArraysX.reversed(vals)[0]);
        int[] csv = Net.bytes("12,34,56,78");
        System.out.println(Csv.fields(csv));
        System.out.println(Csv.fieldAt(csv, 2)[0]);
        System.out.println(Csv.totalInts(csv));
        int[] cfg = JsonX.config(9090, 8);
        System.out.println(JsonX.getInt(cfg, Net.bytes("workers")));
        System.out.println(JsonX.write(cfg).length);
        int[] qty = new int[4]; qty[0] = 5; qty[1] = 50; qty[2] = 2; qty[3] = 9;
        int[] price = new int[4]; price[0] = 100; price[1] = 20; price[2] = 250; price[3] = 75;
        System.out.println(Inventory.total(qty));
        System.out.println(Inventory.lowStock(qty, 10));
        System.out.println(Inventory.value(qty, price));
        int[] orders = new int[4]; orders[0] = 1200; orders[1] = 800; orders[2] = 2000; orders[3] = 300;
        System.out.println(Orders.total(price, qty));
        System.out.println(Orders.countAbove(orders, 1000));
        System.out.println(Orders.maxOrder(orders));
        int[] ids = new int[3]; ids[0] = 10; ids[1] = 20; ids[2] = 30;
        System.out.println(Customer.find(ids, 20));
        System.out.println(Customer.tier(750000));
        System.out.println(Billing.grand(10000, 110, 5));
        System.out.println(Invoice.line(7, 3, 250).length);
        System.out.println(Report.summary(vals).length);
        System.out.println(Validator.sku(Net.bytes("AB-12")));
        System.out.println(Validator.sku(Net.bytes("A!")));
        System.out.println(Pipeline.run(vals));
        int[] tasks = new int[6];
        tasks[0] = 7; tasks[1] = 3; tasks[2] = 9; tasks[3] = 1; tasks[4] = 4; tasks[5] = 2;
        System.out.println(Scheduler.run(tasks, 2));
        int[] logbuf = new int[256];
        LogX.append(logbuf, Net.bytes("boot "));
        LogX.appendInt(logbuf, 42);
        LogX.append(logbuf, Net.bytes(" selesai"));
        System.out.println(LogX.size(logbuf));
        System.out.println(LogX.checksum(logbuf));
        int[] evq = new int[10];
        EventBus.publish(evq, 100); EventBus.publish(evq, 200);
        System.out.println(EventBus.pending(evq));
        System.out.println(EventBus.consume(evq));
        int[] metrics = new int[4];
        Metrics.inc(metrics, 0); Metrics.inc(metrics, 0); Metrics.add(metrics, 2, 5);
        System.out.println(Metrics.get(metrics, 0));
        System.out.println(Metrics.total(metrics));
        System.out.println(TextTable.row(Net.bytes("nama"), Net.bytes("qty")).length);
        System.out.println(Checksum.of(hello));
        System.out.println(Checksum.weak(hello));
        int[] enc = CipherX.rc4(Net.bytes("rahasia"), Net.bytes("kunci"));
        System.out.println(enc.length);
        System.out.println(CipherX.vigenere(Net.bytes("ABC"), Net.bytes("B"))[0]);
        System.out.println(CipherX.unvigenere(CipherX.vigenere(Net.bytes("ABC"), Net.bytes("B")), Net.bytes("B"))[0]);
        System.out.println(HashX.firstByte(Net.bytes("kopi")));
        System.out.println(DpFib.iter(20));
        System.out.println(DpFib.rec(15));
        System.out.println(DpFib.memo(30));
        int[] kw = new int[3]; kw[0] = 2; kw[1] = 3; kw[2] = 4;
        int[] kv = new int[3]; kv[0] = 3; kv[1] = 4; kv[2] = 5;
        System.out.println(DpKnap.solve(kw, kv, 5));
        int[] adj = new int[25];
        for (int i = 0; i < 4; i++) { adj[i * 5 + i + 1] = 1; adj[(i + 1) * 5 + i] = 1; }
        System.out.println(GraphBfs.dist(5, adj, 0)[4]);
        System.out.println(GraphDfs.reachable(5, adj, 0));
        int[] w = new int[9];
        w[0 * 3 + 1] = 4; w[1 * 3 + 2] = 3; w[0 * 3 + 2] = 10;
        System.out.println(DijkstraX.shortest(3, w, 0, 2));
        System.out.println(SieveX.count(100));
        System.out.println(SieveX.sum(50));
        System.out.println(ModularX.powmod(3, 100, 1000000007));
        System.out.println(ModularX.inv(3, 11));
        System.out.println(PermuteX.count(6));
        System.out.println(KmpX.find(Net.bytes("ababcababc"), Net.bytes("abc")));
        System.out.println(RleX.encode(Net.bytes("aaabbc")).length);
        System.out.println(BitOpsX.popcount(255));
        System.out.println(BitOpsX.highest(1024));
        int[] expr = Net.bytes("2+3*4");
        int[] pf = CompilerX.postfix(expr);
        System.out.println(EvalX.eval(pf));
        int[] prog = new int[16];
        prog[0] = 1; prog[1] = 7; prog[2] = 1; prog[3] = 5;
        prog[4] = 3; prog[5] = 5; prog[6] = 4; prog[7] = 6;
        int[] input = new int[1]; input[0] = 6;
        System.out.println(MiniVm.run(prog, input));
        System.out.println(Config.maxWorkers());
        System.out.println(Config.pageSize());
        System.out.println(Config.isProd());
        /* fase memori: beberapa array besar (uji arena/heap) */
        int big = 400000;
        int[] b1 = new int[big];
        int[] b2 = new int[big];
        int[] b3 = new int[big];
        for (int i = 0; i < big; i++) { b1[i] = i % 7; b2[i] = i % 11; b3[i] = i % 13; }
        int s1 = 0; int s2 = 0; int s3 = 0;
        for (int i = 0; i < big; i++) { s1 = s1 + b1[i]; s2 = s2 + b2[i]; s3 = s3 + b3[i]; }
        System.out.println(s1);
        System.out.println(s2);
        System.out.println(s3);
        System.out.println(b1.length + b2.length + b3.length);
        /* fase memori kedua: +12 MB array */
        int big2 = 500000;
        int[] c1 = new int[big2];
        int[] c2 = new int[big2];
        int[] c3 = new int[big2];
        for (int i = 0; i < big2; i++) { c1[i] = (i * 3) % 17; c2[i] = (i * 5) % 19; c3[i] = (i * 7) % 23; }
        int t1 = 0; int t2 = 0; int t3 = 0;
        for (int i = 0; i < big2; i++) { t1 = t1 + c1[i]; t2 = t2 + c2[i]; t3 = t3 + c3[i]; }
        System.out.println(t1);
        System.out.println(t2);
        System.out.println(t3);
        System.out.println(c1.length + c2.length + c3.length);
        System.out.println(SortX.isSorted(sorted));
    }
}
