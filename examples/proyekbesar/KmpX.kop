class KmpX {
    static int[] prefix(int[] p) {
        int[] pi = new int[p.length];
        int k = 0;
        for (int i = 1; i < p.length; i++) {
            while (k > 0 && p[i] != p[k]) k = pi[k - 1];
            if (p[i] == p[k]) k++;
            pi[i] = k;
        }
        return pi;
    }
    static int find(int[] t, int[] p) {
        if (p.length == 0) return 0;
        int[] pi = prefix(p);
        int k = 0;
        for (int i = 0; i < t.length; i++) {
            while (k > 0 && t[i] != p[k]) k = pi[k - 1];
            if (t[i] == p[k]) k++;
            if (k == p.length) return i - p.length + 1;
        }
        return -1;
    }
}
