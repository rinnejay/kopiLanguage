class Fnv {
    static int hash(int[] data) {
        int h = (int)2166136261L;
        for (int i = 0; i < data.length; i++) {
            h = h ^ (data[i] & 255);
            h = h * 16777619;
        }
        return h;
    }
    static int hash2(int v, int salt) {
        int h = v ^ salt;
        h = h * 16777619;
        h = h ^ (h >> 13);
        return h;
    }
}
