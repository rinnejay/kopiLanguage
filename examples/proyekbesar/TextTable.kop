import Bytes;
import Conv;

class TextTable {
    static int[] pad(int[] s, int width) {
        int[] o = new int[width];
        int i = 0;
        while (i < width) {
            if (i < s.length) o[i] = s[i];
            else o[i] = 32;
            i++;
        }
        return o;
    }
    static int[] row(int[] a, int[] b) {
        return Bytes.cat(pad(a, 10), pad(b, 10));
    }
}
