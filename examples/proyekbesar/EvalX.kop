import StackX;

class EvalX {
    static int eval(int[] pf) {
        int[] st = new int[pf.length + 1];
        for (int i = 0; i < pf.length; i++) {
            int t = pf[i];
            if (t < 1000) { StackX.push(st, t); }
            else {
                int b = StackX.pop(st);
                int a = StackX.pop(st);
                if (t == 1043) StackX.push(st, a + b);
                else if (t == 1045) StackX.push(st, a - b);
                else if (t == 1042) StackX.push(st, a * b);
                else if (t == 1047) { if (b != 0) StackX.push(st, a / b); else StackX.push(st, 0); }
            }
        }
        return StackX.pop(st);
    }
}
