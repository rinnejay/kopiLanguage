import Json;

class JsonX {
    static int[] config(int port, int workers) {
        return Json.obj4("app", Json.str("KopiMart"),
                         "port", Json.num(Net.mkstr(Conv.itoa(port))),
                         "workers", Json.num(Net.mkstr(Conv.itoa(workers))),
                         "debug", Json.boolV(0));
    }
    static int getInt(int[] j, String key) {
        return Json.asInt(Json.get(j, key));
    }
    static String write(int[] j) { return Json.write(j); }
}
