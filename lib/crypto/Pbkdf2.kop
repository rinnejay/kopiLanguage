// Pbkdf2.kop — PBKDF2-HMAC-SHA256 (RFC 8018) murni Kopi (v1.10.0).
//
// Dipakai untuk menyimpan kata sandi: hash = PBKDF2(password, salt,
// iterasi, 32). Verifikasi dengan membandingkan hasil secara konstan.

import Hash;
import Str;

class Pbkdf2 {

    static int[] sha256(int[] pass, int[] salt, int iter, int dkLen) {
        if (iter < 1) iter = 1;
        if (dkLen < 1) dkLen = 1;
        /* semua buffer hasil dialokasikan SEBELUM mark; HMAC sementara
         * dibebaskan tiap iterasi supaya 100k iterasi tidak OOM. */
        int[] pass2 = Str.copy(pass);
        int[] salt2 = Str.copy(salt);
        int[] t = new int[32];
        int[] ucur = new int[32];
        int[] out = new int[dkLen];
        int mark = Net.memMark();
        int blocks = (dkLen + 31) / 32;
        int o = 0;
        for (int b = 1; b <= blocks; b++) {
            int[] msg = new int[salt2.length + 4];
            for (int i = 0; i < salt2.length; i++) msg[i] = salt2[i];
            msg[salt2.length] = (b >>> 24) & 255;
            msg[salt2.length + 1] = (b >>> 16) & 255;
            msg[salt2.length + 2] = (b >>> 8) & 255;
            msg[salt2.length + 3] = b & 255;

            int[] u = Hash.hmac(pass2, msg);
            for (int i = 0; i < 32; i++) { ucur[i] = u[i]; t[i] = u[i]; }
            for (int n = 1; n < iter; n++) {
                u = Hash.hmac(pass2, ucur);
                for (int i = 0; i < 32; i++) { ucur[i] = u[i]; t[i] = t[i] ^ u[i]; }
            }
            for (int i = 0; i < 32 && o < dkLen; i++) { out[o] = t[i]; o++; }
            Net.memReset(mark);
        }
        return out;
    }
}
