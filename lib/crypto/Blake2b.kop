/* Blake2b.kop — BLAKE2b (RFC 7693) murni di bahasa Kopi (v1.30).
 *
 * Digest 1..64 byte, opsional dengan kunci. Fondasi untuk Argon2 dan
 * scrypt-family.
 *
 * Semua aritmetika 64-bit memakai tipe `long` (bungkus modulo 2^64).
 * Rotasi kanan: (x >>> n) | (x << (64-n)), n != 0.
 *
 * Fungsi:
 *   hash(msg, outLen)           → digest
 *   hashKeyed(msg, key, outLen) → digest dengan kunci (kunci ≤ 64 byte)
 */

class Blake2b {

    /* konstanta IV = akar kuadrat pecahan 8 prima pertama (sama dgn SHA-512) */
    private static long[] iv() {
        long[] v = new long[8];
        v[0] = 7640891576956012808L;
        v[1] = -4942790177534073029L;
        v[2] = 4354685564936845355L;
        v[3] = -6534734903238641935L;
        v[4] = 5840696475078001361L;
        v[5] = -7276294671716946913L;
        v[6] = 2270897969802886507L;
        v[7] = 6620516959819538809L;
        return v;
    }

    /* tabel sigma: 12 ronde × 16 indeks (rond 10 = 0, ronde 11 = 1) */
    private static int[] sigma() {
        int[] s = new int[192];
        s[0] = 0;  s[1] = 1;  s[2] = 2;  s[3] = 3;  s[4] = 4;  s[5] = 5;  s[6] = 6;  s[7] = 7;
        s[8] = 8;  s[9] = 9;  s[10] = 10; s[11] = 11; s[12] = 12; s[13] = 13; s[14] = 14; s[15] = 15;
        s[16] = 14; s[17] = 10; s[18] = 4;  s[19] = 8;  s[20] = 9;  s[21] = 15; s[22] = 13; s[23] = 6;
        s[24] = 1;  s[25] = 12; s[26] = 0;  s[27] = 2;  s[28] = 11; s[29] = 7;  s[30] = 5;  s[31] = 3;
        s[32] = 11; s[33] = 8;  s[34] = 12; s[35] = 0;  s[36] = 5;  s[37] = 2;  s[38] = 15; s[39] = 13;
        s[40] = 10; s[41] = 14; s[42] = 3;  s[43] = 6;  s[44] = 7;  s[45] = 1;  s[46] = 9;  s[47] = 4;
        s[48] = 7;  s[49] = 9;  s[50] = 3;  s[51] = 1;  s[52] = 13; s[53] = 12; s[54] = 11; s[55] = 14;
        s[56] = 2;  s[57] = 6;  s[58] = 5;  s[59] = 10; s[60] = 4;  s[61] = 0;  s[62] = 15; s[63] = 8;
        s[64] = 9;  s[65] = 0;  s[66] = 5;  s[67] = 7;  s[68] = 2;  s[69] = 4;  s[70] = 10; s[71] = 15;
        s[72] = 14; s[73] = 1;  s[74] = 11; s[75] = 12; s[76] = 6;  s[77] = 8;  s[78] = 3;  s[79] = 13;
        s[80] = 2;  s[81] = 12; s[82] = 6;  s[83] = 10; s[84] = 0;  s[85] = 11; s[86] = 8;  s[87] = 3;
        s[88] = 4;  s[89] = 13; s[90] = 7;  s[91] = 5;  s[92] = 15; s[93] = 14; s[94] = 1;  s[95] = 9;
        s[96] = 12; s[97] = 5;  s[98] = 1;  s[99] = 15; s[100] = 14; s[101] = 13; s[102] = 4; s[103] = 10;
        s[104] = 0; s[105] = 7;  s[106] = 6; s[107] = 3;  s[108] = 9; s[109] = 2;  s[110] = 8; s[111] = 11;
        s[112] = 13; s[113] = 11; s[114] = 7;  s[115] = 14; s[116] = 12; s[117] = 1; s[118] = 3; s[119] = 9;
        s[120] = 5;  s[121] = 0;  s[122] = 15; s[123] = 4;  s[124] = 8; s[125] = 6; s[126] = 2; s[127] = 10;
        s[128] = 6;  s[129] = 15; s[130] = 14; s[131] = 9;  s[132] = 11; s[133] = 3; s[134] = 0; s[135] = 8;
        s[136] = 12; s[137] = 2;  s[138] = 13; s[139] = 7;  s[140] = 1;  s[141] = 4; s[142] = 10; s[143] = 5;
        s[144] = 10; s[145] = 2;  s[146] = 8;  s[147] = 4;  s[148] = 7;  s[149] = 6;  s[150] = 1;  s[151] = 5;
        s[152] = 15; s[153] = 11; s[154] = 9;  s[155] = 14; s[156] = 3;  s[157] = 12; s[158] = 13; s[159] = 0;
        s[160] = 0;  s[161] = 1;  s[162] = 2;  s[163] = 3;  s[164] = 4;  s[165] = 5;  s[166] = 6;  s[167] = 7;
        s[168] = 8;  s[169] = 9;  s[170] = 10; s[171] = 11; s[172] = 12; s[173] = 13; s[174] = 14; s[175] = 15;
        s[176] = 14; s[177] = 10; s[178] = 4;  s[179] = 8;  s[180] = 9;  s[181] = 15; s[182] = 13; s[183] = 6;
        s[184] = 1;  s[185] = 12; s[186] = 0;  s[187] = 2;  s[188] = 11; s[189] = 7;  s[190] = 5;  s[191] = 3;
        return s;
    }

    /* rotasi kanan 64-bit */
    private static long ror(long x, int n) {
        if (n == 0) return x;
        return (x >>> n) | (x << (64 - n));
    }

    /* fungsi G (v = 16 kata keadaan) */
    private static void g(long[] v, int a, int b, int c, int d, long x, long y) {
        v[a] = v[a] + v[b] + x;
        v[d] = ror(v[d] ^ v[a], 32);
        v[c] = v[c] + v[d];
        v[b] = ror(v[b] ^ v[c], 24);
        v[a] = v[a] + v[b] + y;
        v[d] = ror(v[d] ^ v[a], 16);
        v[c] = v[c] + v[d];
        v[b] = ror(v[b] ^ v[c], 63);
    }

    /* kompresi F: h (8 kata) & m (blok 128 byte) & t (counter 128 bit) */
    private static void compress(long[] h, int[] m, long t0, long t1, boolean last) {
        long[] iv = iv();
        int[] sg = sigma();
        long[] v = new long[16];
        for (int i = 0; i < 8; i++) v[i] = h[i];
        for (int i = 0; i < 8; i++) v[8 + i] = iv[i];
        v[12] = v[12] ^ t0;
        v[13] = v[13] ^ t1;
        /* '~' belum didukung untuk long → pakai ~(x) = -x-1 (dua's complement) */
        if (last) v[14] = (0L - v[14] - 1L);
        long[] w = words(m);
        for (int r = 0; r < 12; r++) {
            int b0 = r * 16;
            g(v, 0, 4, 8, 12, w[sg[b0]], w[sg[b0 + 1]]);
            g(v, 1, 5, 9, 13, w[sg[b0 + 2]], w[sg[b0 + 3]]);
            g(v, 2, 6, 10, 14, w[sg[b0 + 4]], w[sg[b0 + 5]]);
            g(v, 3, 7, 11, 15, w[sg[b0 + 6]], w[sg[b0 + 7]]);
            g(v, 0, 5, 10, 15, w[sg[b0 + 8]], w[sg[b0 + 9]]);
            g(v, 1, 6, 11, 12, w[sg[b0 + 10]], w[sg[b0 + 11]]);
            g(v, 2, 7, 8, 13, w[sg[b0 + 12]], w[sg[b0 + 13]]);
            g(v, 3, 4, 9, 14, w[sg[b0 + 14]], w[sg[b0 + 15]]);
        }
        for (int i = 0; i < 8; i++) h[i] = h[i] ^ v[i] ^ v[8 + i];
    }

    /* blok 128 byte → 16 kata 64-bit little-endian */
    private static long[] words(int[] m) {
        long[] w = new long[16];
        for (int i = 0; i < 16; i++) {
            long v = 0;
            for (int j = 7; j >= 0; j--) {
                v = (v << 8) | (long)(m[i * 8 + j] & 255);
            }
            w[i] = v;
        }
        return w;
    }

    /* digest tanpa kunci */
    static int[] hash(int[] msg, int outLen) {
        return hashKeyed(msg, new int[0], outLen);
    }

    /* digest dengan kunci (kunci ≤ 64 byte) */
    static int[] hashKeyed(int[] msg, int[] key, int outLen) {
        if (outLen < 1) outLen = 1;
        if (outLen > 64) outLen = 64;
        int klen = key.length;
        if (klen > 64) klen = 64;
        long[] h = iv();
        h[0] = h[0] ^ (0x01010000L ^ ((long)klen << 8) ^ (long)outLen);
        long total = 0;
        if (klen > 0) {
            int[] keyBlock = new int[128];
            for (int i = 0; i < klen; i++) keyBlock[i] = key[i] & 255;
            total = 128L;
            compress(h, keyBlock, total, 0L, false);
        }
        int len = msg.length;
        int blocks = len / 128;
        int rest = len % 128;
        for (int bi = 0; bi < blocks; bi++) {
            int[] blk = new int[128];
            for (int i = 0; i < 128; i++) blk[i] = msg[bi * 128 + i] & 255;
            total = total + 128L;
            compress(h, blk, total, 0L, false);
        }
        int[] last = new int[128];
        for (int i = 0; i < rest; i++) last[i] = msg[blocks * 128 + i] & 255;
        total = total + (long)rest;
        compress(h, last, total, 0L, true);
        int[] out = new int[outLen];
        for (int i = 0; i < outLen; i++) {
            out[i] = (int)((h[i / 8] >>> ((i % 8) * 8)) & 255L);
        }
        return out;
    }
}
