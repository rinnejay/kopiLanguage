    private static int[] HH0() {
        int[] k = new int[8];
        /* akar kuadrat 8 prima pertama, pecahan 32-bit (§5.3.3) */
        k[0] = 1779033703;
        k[1] = -1150833019;
        k[2] = 1013904242;
        k[3] = -1521486534;
        k[4] = 1359893119;
        k[5] = -1694144372;
        k[6] = 528734635;
        k[7] = 1541459225;
        return k;
    }

    /* penjumlahan modulo 2^32 */
    static int uadd(int x, int y) {
        int lo = (x & 65535) + (y & 65535);
        int hi = ((x >>> 16) + (y >>> 16)) + (lo >>> 16);
        return ((hi & 65535) << 16) | (lo & 65535);
    }

    /* rotasi kanan 32-bit; count 0 aman */
    static int rotr(int x, int n) {
        if (n == 0) return x;
        return (x >>> n) | (x << (32 - n));
    }

    private static int m0(int x) { return rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3); }
    private static int m1(int x) { return rotr(x, 17) ^ rotr(x, 19) ^ (x >>> 10); }
    private static int s0(int x) { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
    private static int s1(int x) { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }
    private static int ch(int x, int y, int z) { return (x & y) ^ (~x & z); }
    private static int maj(int x, int y, int z) { return (x & y) ^ (x & z) ^ (y & z); }

    /* satu-shot: pesan byte-as-int (0..255) → digest 32 byte-as-int */
    static int[] sha256(int[] msg) {
        int L = msg.length;
        int total = L + 9;
        int nblk = (total + 63) / 64;
        int nsz = nblk * 64;
        int[] m = new int[nsz];
        int i = 0;
        while (i < L) { m[i] = msg[i]; i++; }
        m[L] = 128;                          /* 0x80 */
        int bitlen = L * 8;
        m[nsz - 4] = (bitlen >>> 24) & 255;  /* len 64-bit BE; v1: < 2^31 bit */
        m[nsz - 3] = (bitlen >>> 16) & 255;
        m[nsz - 2] = (bitlen >>> 8) & 255;
        m[nsz - 1] = bitlen & 255;

        int[] H = HH0();
        int[] K = KK();
        int[] st = new int[8];
        for (i = 0; i < 8; i++) st[i] = H[i];

        int[] w = new int[64];
        int[] tmp = new int[8];              /* a..h untuk penambahan akhir */
        for (int blk = 0; blk < nblk; blk++) {
            int base = blk * 64;
            for (i = 0; i < 16; i++) {
                int t = base + i * 4;
                w[i] = (m[t] << 24) | (m[t + 1] << 16) | (m[t + 2] << 8) | m[t + 3];
            }
            for (i = 16; i < 64; i++) {
                w[i] = uadd(uadd(m1(w[i - 2]), w[i - 7]),
                            uadd(m0(w[i - 15]), w[i - 16]));
            }
            int a = st[0], b = st[1], c = st[2], d = st[3];
            int e = st[4], f = st[5], g = st[6], h = st[7];
            for (i = 0; i < 64; i++) {
                int T1 = uadd(h, uadd(s1(e), uadd(ch(e, f, g), uadd(K[i], w[i]))));
                int T2 = uadd(s0(a), maj(a, b, c));
                h = g; g = f; f = e;
                e = uadd(d, T1);
                d = c; c = b; b = a;
                a = uadd(T1, T2);
            }
            tmp[0] = a; tmp[1] = b; tmp[2] = c; tmp[3] = d;
            tmp[4] = e; tmp[5] = f; tmp[6] = g; tmp[7] = h;
            for (i = 0; i < 8; i++) st[i] = uadd(st[i], tmp[i]);
        }

        int[] out = new int[32];
        for (i = 0; i < 8; i++) {
            for (int j = 0; j < 4; j++) out[i * 4 + j] = (st[i] >>> (24 - j * 8)) & 255;
        }
        return out;
    }

    /* HMAC-SHA256 (RFC 2104); key > 64 byte di-hash dulu */
    static int[] hmac(int[] key, int[] msg) {
        int[] k = key;
        if (key.length > 64) k = sha256(key);
        int[] ki = new int[64];
        int[] ko = new int[64];
        for (int i = 0; i < 64; i++) {
            int v = 0;
            if (i < k.length) v = k[i];
            ki[i] = v ^ 54;                  /* 0x36 */
            ko[i] = v ^ 92;                  /* 0x5C */
        }
        int[] imsg = new int[64 + msg.length];
        for (int i = 0; i < 64; i++) imsg[i] = ki[i];
        for (int i = 0; i < msg.length; i++) imsg[64 + i] = msg[i];
        int[] ih = sha256(imsg);
        int[] omsg = new int[96];
        for (int i = 0; i < 64; i++) omsg[i] = ko[i];
        for (int i = 0; i < 32; i++) omsg[64 + i] = ih[i];
        return sha256(omsg);
    }

    /* ── SHA-512 (FIPS 180-4) ─────────────────────────────────── */

    private static long rotr64(long x, int n) {
        if (n == 0) return x;
        return (x >>> n) | (x << (64 - n));
    }

    private static long bigSigma0(long x) { return rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39); }
    private static long bigSigma1(long x) { return rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41); }
    private static long smallSigma0(long x) { return rotr64(x, 1) ^ rotr64(x, 8) ^ (x >>> 7); }
    private static long smallSigma1(long x) { return rotr64(x, 19) ^ rotr64(x, 61) ^ (x >>> 6); }
    private static long ch64(long x, long y, long z) { return (x & y) ^ (~x & z); }
    private static long maj64(long x, long y, long z) { return (x & y) ^ (x & z) ^ (y & z); }

    private static int[] shaCore(long[] init, long[] k, int[] msg, int outLen) {
        int L = msg.length;
        int total = L + 9;
        int nblk = (total + 127) / 128;
        int nsz = nblk * 128;
        int[] m = new int[nsz];
        int i = 0;
        while (i < L) { m[i] = msg[i]; i++; }
        m[L] = 128;
        long bitlen = L * 8L;
        for (int j = 0; j < 8; j++) {
            int shift = 56 - j * 8;
            long part = (bitlen >>> shift) & 255L;
            m[nsz - 8 + j] = (int)part;
        }
        long[] h = new long[8];
        for (i = 0; i < 8; i++) h[i] = init[i];
        long[] w = new long[80];
        for (int blk = 0; blk < nblk; blk++) {
            int base = blk * 128;
            for (i = 0; i < 16; i++) {
                int t = base + i * 8;
                long wv = 0;
                for (int j = 0; j < 8; j++) wv = (wv << 8) | (long)(m[t + j] & 255);
                w[i] = wv;
            }
            for (i = 16; i < 80; i++) {
                long s0 = smallSigma0(w[i - 15]);
                long s1 = smallSigma1(w[i - 2]);
                w[i] = w[i - 16] + s0 + w[i - 7] + s1;
            }
            long a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
            for (i = 0; i < 80; i++) {
                long t1 = hh + bigSigma1(e) + ch64(e, f, g) + k[i] + w[i];
                long t2 = bigSigma0(a) + maj64(a, b, c);
                hh = g; g = f; f = e;
                e = d + t1;
                d = c; c = b; b = a;
                a = t1 + t2;
            }
            h[0] = h[0] + a;
            h[1] = h[1] + b;
            h[2] = h[2] + c;
            h[3] = h[3] + d;
            h[4] = h[4] + e;
            h[5] = h[5] + f;
            h[6] = h[6] + g;
            h[7] = h[7] + hh;
        }
        int[] out = new int[outLen];
        for (i = 0; i < 8; i++) {
            long v = h[i];
            for (int j = 0; j < 8; j++) {
                int idx = i * 8 + j;
                if (idx < outLen) {
                    int shift = 56 - j * 8;
                    out[idx] = (int)((v >>> shift) & 255L);
                }
            }
        }
        return out;
    }

