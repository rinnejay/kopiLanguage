/* Crypto.kop — utilitas hash & cipher untuk Kopi (v1: aritmetika murni).
 *
 * Bahasa Kopi v1 belum punya operator bitwise (^ & << >>), jadi semua
 * operasi bit dikerjakan lewat bagian aritmetika + tabel — hasilnya tetap
 * oke untuk hash cache, PRNG, dan cipher demo; bukan untuk kriptografi
 * produksi (tanda di README).
 *
 * Konvensi byte: int 0..255 (byte-as-int) di dalam array int[].
 */

class Crypto {

    /* ── fondasi bitwise tanpa operator bitwise ─────────────────── */

    /* xor bit-demi-bit untuk nilai NONNEGATIF < 2^31 */
    static int bitxor(int a, int b) {
        int r = 0;
        int p = 1;
        for (int i = 0; i < 31; i++) {
            int na = a % 2;
            int nb = b % 2;          /* bit terendah */
            boolean beda = na != nb;
            if (beda) r = r + p;                 /* xor = bit berbeda */
            a = a / 2;
            b = b / 2;
            p = p + p;
        }
        return r;
    }

    /* banding dua array: 1 jika sama panjang & tiap elemen sama */
    static int arrEq(int[] a, int[] b) {
        if (a.length != b.length) return 0;
        for (int i = 0; i < a.length; i++)
            if (a[i] != b[i]) return 0;
        return 1;
    }

    static int abs_(int x) {
        if (x < 0) return -x;
        return x;
    }

    /* ── hash ───────────────────────────────────────────────────── */

    /* FNV-1a 32-bit darider array byte-as-int (len elemen pertama) */
    static int fnv1a(int[] data, int len) {
        int h = (int)2166136261L;
        int HMAX = (int)(4294967296L - 1L);      /* 2^32 - 1 (wrap) */
        for (int i = 0; i < len; i++) {
            int b = data[i] % 256;
            if (b < 0) b = b + 256;
            h = bitxor(h, b);
            h = h * 16777619;
        }
        return abs_(h);
    }

    /* ── PRNG ──────────────────────────────────────────────────── */

    /* Lehmer/LCG (Schrage) — perkiraan berpisah murni int,
     * seed/mulai 1..2^31-2, hasil [0, M) */
    static int nextRand(int x) {
        int M = 2147483647;
        int A = 48271;
        int Q = 44488;
        int R = 3399;
        int hi = x / Q;
        int lo = x % Q;
        int t = A * lo - R * hi;
        if (t <= 0) t = t + M;
        return t;
    }

    static int randRange(int seed, int hi) {
        if (hi <= 0) return 0;
        int r = nextRand(seed);
        if (r < 0) r = -r;
        return r % hi;
    }

    /* ── sandbox bitwise penuh (domain 31-bit, 0..2147483647) ────── */

    /* identitas aritmétika: A + B = (A⊕B) + 2·(A∧B)  ⟹  ia juga
     * A∧B = (A+B−A⊕B)/2 dan A∨B = A⊕B + A∧B — tanpa operator & | ^ */
    static int bitand(int a, int b) {
        return (a + b - bitxor(a, b)) / 2;
    }

    static int bitor(int a, int b) {
        return bitxor(a, b) + bitand(a, b);
    }

    /* komplemen 31-bit (pelengkap di dalam 0..2^31-1) */
    static int bitnot(int x) {
        return 2147483647 - x;
    }

    /* 2^n untuk n 0..30 (n=31 membanjir tanda) */
    static int pow31(int n) {
        int p = 1;
        for (int i = 0; i < n; i++) p = p + p;
        return p;
    }

    /* masker n bit terendah */
    static int mask31(int n) {
        if (n <= 0) return 0;
        if (n >= 31) return 2147483647;
        return pow31(n) - 1;
    }

    /* geser kiri, bit di atas 2^31 dibuang */
    static int shl31(int x, int n) {
        if (n <= 0) return x;
        if (n >= 31) return 0;
        return (x % pow31(31 - n)) * pow31(n);
    }

    /* geser kanan logis (masukan positif) */
    static int shr31(int x, int n) {
        if (n <= 0) return x;
        if (n >= 31) return 0;
        return x / pow31(n);
    }

    /* rotasi kiri 31-bit (bit paling atas mengalirlah ke bawah) */
    static int rotl31(int x, int n) {
        n = n % 31;
        if (n == 0) return x;
        return shl31(x, n) + x / pow31(31 - n);
    }

    /* rotasi kanan */
    static int rotr31(int x, int n) {
        return rotl31(x, 31 - (n % 31));
    }

    /* ── cipher ────────────────────────────────────────────────── */

    /* XOR stream: out[i] = in[i] ^ key[i % key.length]
     * XOR nirl: pemanggilan kedua dengan key yang sama = dekripsi. */
    static int[] xorStream(int[] inp, int[] key) {
        int[] out = new int[inp.length];
        for (int i = 0; i < inp.length; i++) {
            int a = inp[i] % 256;
            int k = key[i % key.length] % 256;
            if (a < 0) a = a + 256;
            if (k < 0) k = k + 256;
            int x = bitxor(a, k);
            out[i] = x;
        }
        return out;
    }

    /* Caesar shift (+k mod 256) — disetara beserta 'uncaesar' */
    static int[] caesar(int[] inp, int k) {
        int[] out = new int[inp.length];
        for (int i = 0; i < inp.length; i++) {
            int c = (inp[i] + k) % 256;
            if (c < 0) c = c + 256;
            out[i] = c;
        }
        return out;
    }

    static int[] uncaesar(int[] inp, int k) {
        return caesar(inp, 256 - (k % 256));
    }
}
