// HttpServer.kop — server HTTP/1.1 murni Kopi (v1.9.2).
// Keep-alive, HEAD, cookie, dan body chunked didukung; lihat README.
// Blocking, satu koneksi pada satu waktu; Connection: close per respons.
// Pakai bersama Net.listen/accept + Net.memMark/memReset:
//
//   int fd = Net.socket(2, 1);
//   Net.setsockopt(fd, 1, 2, 1);          // SO_REUSEADDR
//   Net.bind(fd, 0, 8080); Net.listen(fd, 16);
//   while (true) {
//     int c = Net.accept(fd);
//     int mark = Net.memMark();
//     int[] req = HttpServer.readRequest(c, 16384);
//     HttpServer.send(c, HttpServer.text(200, "ok\n"));
//     Net.close(c);
//     Net.memReset(mark);
//   }

import Bytes;
import Str;

class HttpServer {

    static int[] CRLF() { return Net.bytes("\r\n"); }
    static int[] CRLF2() { return Net.bytes("\r\n\r\n"); }
    static int[] SP() { return Net.bytes(" "); }

    /* baca request (header + body sesuai Content-Length).
     * hasil = seluruh byte request; array kosong bila EOF/galat. */
    static int[] readRequest(int fd, int max) {
        int[] buf = new int[max];
        int got = 0;
        int he = -1;
        while (got < max) {
            int[] chunk = new int[max - got];
            int n = Net.recv1(fd, chunk);
            if (n <= 0) break;
            for (int i = 0; i < n; i++) buf[got + i] = chunk[i];
            got = got + n;
            he = Bytes.indexOf(buf, CRLF2(), 0);
            if (he >= 0 && he < got) break;
        }
        if (he < 0 || he >= got) {
            if (got <= 0) return new int[0];
            return Bytes.slice(buf, 0, got);
        }
        int endHead = he + 4;
        int[] headOnly = Bytes.slice(buf, 0, endHead);
        int cl = contentLength(headOnly);
        int need = endHead + cl;
        if (need > max) need = max;
        while (got < need) {
            int[] chunk2 = new int[need - got];
            int n2 = Net.recv1(fd, chunk2);
            if (n2 <= 0) break;
            for (int i = 0; i < n2; i++) buf[got + i] = chunk2[i];
            got = got + n2;
        }
        return Bytes.slice(buf, 0, got);
    }

    static int[] requestLine(int[] req) {
        int e = Bytes.indexOf(req, CRLF(), 0);
        if (e < 0) e = req.length;
        return Bytes.slice(req, 0, e);
    }

    static String method(int[] req) {
        int[] l = requestLine(req);
        int sp = Bytes.indexOf(l, SP(), 0);
        if (sp < 0) return Net.mkstr(l);
        return Net.mkstr(Bytes.slice(l, 0, sp));
    }

    static String target(int[] req) {
        int[] l = requestLine(req);
        int sp = Bytes.indexOf(l, SP(), 0);
        if (sp < 0) return "";
        int sp2 = Bytes.indexOf(l, SP(), sp + 1);
        if (sp2 < 0) sp2 = l.length;
        return Net.mkstr(Bytes.slice(l, sp + 1, sp2 - sp - 1));
    }

    static String path(int[] req) { return pathOnly(target(req)); }

    static String pathOnly(String target) {
        int q = findChar(target, 63, 0, target.length);   /* '?' */
        if (q < 0) return target;
        return Str.sub(target, 0, q);
    }

    static String version(int[] req) {
        int[] l = requestLine(req);
        int sp = Bytes.indexOf(l, SP(), 0);
        if (sp < 0) return "";
        int sp2 = Bytes.indexOf(l, SP(), sp + 1);
        if (sp2 < 0) return "";
        return Net.mkstr(Bytes.slice(l, sp2 + 1, l.length - sp2 - 1));
    }

    /* cari byte pada String dalam rentang [from,to) */
    static int findChar(String s, int b, int from, int to) {
        int i = from;
        while (i < to && i < s.length) {
            if (s[i] == b) return i;
            i++;
        }
        return -1;
    }

    static String headerValue(int[] req, String name) {
        int he = Bytes.indexOf(req, CRLF2(), 0);
        if (he < 0) he = req.length;
        int p = Bytes.indexOf(req, CRLF(), 0);
        if (p < 0 || p + 2 > he) return "";
        String block = Net.mkstr(Bytes.slice(req, p + 2, he - p - 2));
        int i = 0;
        while (i < block.length) {
            int ls = i;
            while (i < block.length && block[i] != 13 && block[i] != 10) i++;
            int le = i;
            if (nameAt(block, ls, le, name))
                return Str.trim(Str.sub(block, ls + name.length + 1,
                                        le - ls - name.length - 1));
            while (i < block.length && (block[i] == 13 || block[i] == 10)) i++;
        }
        return "";
    }

    static int lowerc(int c) {
        if (c >= 65 && c <= 90) return c + 32;
        return c;
    }

    /* true bila baris diawali `name` lalu ':' (case-insensitive) */
    static boolean nameAt(String line, int ls, int le, String name) {
        if (ls + name.length >= le) return false;
        if (line[ls + name.length] != 58) return false;
        for (int i = 0; i < name.length; i++)
            if (lowerc(line[ls + i]) != lowerc(name[i])) return false;
        return true;
    }

    static int contentLength(int[] req) {
        String v = headerValue(req, "Content-Length");
        if (v.length == 0) return 0;
        return Str.toInt(v);
    }

    static int[] body(int[] req) {
        int he = Bytes.indexOf(req, CRLF2(), 0);
        if (he < 0) return new int[0];
        int start = he + 4;
        if (start >= req.length) return new int[0];
        int cl = contentLength(req);
        int avail = req.length - start;
        if (cl <= 0) return Bytes.slice(req, start, avail);
        if (cl > avail) cl = avail;
        return Bytes.slice(req, start, cl);
    }

    static int hexv(int c) {
        if (c >= 48 && c <= 57) return c - 48;
        if (c >= 65 && c <= 70) return c - 55;
        if (c >= 97 && c <= 102) return c - 87;
        return -1;
    }

    static String urlDecode(String s) {
        int[] out = new int[s.length];
        int k = 0;
        int i = 0;
        while (i < s.length) {
            int c = s[i];
            if (c == 43) { out[k] = 32; k++; i++; }
            else if (c == 37 && i + 2 < s.length) {
                int a = hexv(s[i + 1]);
                int b = hexv(s[i + 2]);
                if (a >= 0 && b >= 0) {
                    out[k] = a * 16 + b;
                    k++;
                    i = i + 3;
                } else {
                    out[k] = c; k++; i++;
                }
            } else {
                out[k] = c;
                k++;
                i++;
            }
        }
        return Net.mkstr(Bytes.slice(out, 0, k));
    }

    static String queryValue(int[] req, String key) {
        String t = target(req);
        int q = findChar(t, 63, 0, t.length);
        if (q < 0) return "";
        int p = q + 1;
        while (p <= t.length) {
            int amp = findChar(t, 38, p, t.length);        /* '&' */
            int e = amp;
            if (e < 0) e = t.length;
            int eq = findChar(t, 61, p, e);                /* '=' */
            if (eq < 0) eq = e;
            String nm = Str.sub(t, p, eq - p);
            if (nm == key) {
                String val = Str.sub(t, eq + 1, e - eq - 1);
                return urlDecode(val);
            }
            if (amp < 0) break;
            p = amp + 1;
        }
        return "";
    }

    static String statusText(int code) {
        if (code == 200) return "OK";
        if (code == 202) return "Accepted";
        if (code == 206) return "Partial Content";
        if (code == 201) return "Created";
        if (code == 204) return "No Content";
        if (code == 304) return "Not Modified";
        if (code == 301) return "Moved Permanently";
        if (code == 302) return "Found";
        if (code == 307) return "Temporary Redirect";
        if (code == 308) return "Permanent Redirect";
        if (code == 400) return "Bad Request";
        if (code == 401) return "Unauthorized";
        if (code == 403) return "Forbidden";
        if (code == 404) return "Not Found";
        if (code == 405) return "Method Not Allowed";
        if (code == 413) return "Payload Too Large";
        if (code == 429) return "Too Many Requests";
        if (code == 500) return "Internal Server Error";
        if (code == 503) return "Service Unavailable";
        return "OK";
    }

    static int[] responseKA(int code, String ctype, int[] body, int keep) {
        String h = "HTTP/1.1 " + Str.fromInt(code) + " " + statusText(code)
                 + "\r\nContent-Type: " + ctype
                 + "\r\nContent-Length: " + Str.fromInt(body.length);
        if (keep != 0) h = h + "\r\nConnection: keep-alive";
        else h = h + "\r\nConnection: close";
        return Bytes.cat(Net.strbytes(h + "\r\n\r\n"), body);
    }

    /* respons dengan header tambahan (mis. Set-Cookie) */
    static int[] respond(int code, String ctype, int[] body, String extra, int keep) {
        String h = "HTTP/1.1 " + Str.fromInt(code) + " " + statusText(code)
                 + "\r\nContent-Type: " + ctype
                 + "\r\nContent-Length: " + Str.fromInt(body.length) + "\r\n";
        if (extra.length > 0) h = h + extra;
        if (keep != 0) h = h + "Connection: keep-alive\r\n";
        else h = h + "Connection: close\r\n";
        return Bytes.cat(Net.strbytes(h + "\r\n"), body);
    }

    static int[] response(int code, String ctype, int[] body) {
        return responseKA(code, ctype, body, 0);
    }

    /* HEAD: header tetap (Content-Length body), tanpa body */
    static int[] headOnly(int[] resp) {
        int p = Bytes.indexOf(resp, CRLF2(), 0);
        if (p < 0) return resp;
        return Bytes.slice(resp, 0, p + 4);
    }

    static int[] responseFor(int[] req, int code, String ctype, int[] body, int keep) {
        int[] r = responseKA(code, ctype, body, keep);
        if (methodIs(req, "HEAD")) return headOnly(r);
        return r;
    }

    static boolean methodIs(int[] req, String m) {
        return method(req) == m;
    }

    static int[] text(int code, String body) {
        return response(code, "text/plain; charset=utf-8", body);
    }

    static int[] html(int code, String body) {
        return response(code, "text/html; charset=utf-8", body);
    }

    static int[] jsonResponse(String body) {
        return response(200, "application/json", body);
    }

    static int[] notFound() {
        return text(404, "not found\n");
    }

    static int[] forbidden() {
        return text(403, "forbidden\n");
    }

    /* ── keep-alive, cookie, body chunked (v1.9.2) ─────────────── */

    static boolean keepAlive(int[] req) {
        String v = headerValue(req, "Connection");
        String ver = version(req);
        if (Str.contains(ver, "1.1")) return !Str.equalsIgnoreCase(v, "close");
        return Str.equalsIgnoreCase(v, "keep-alive");
    }

    /* nilai cookie dari header "Cookie: a=1; b=2" */
    static String cookie(int[] req, String name) {
        String h = headerValue(req, "Cookie");
        int i = 0;
        while (i < h.length) {
            while (i < h.length && (h[i] == 32 || h[i] == 59)) i++;   /* spasi ; */
            int s0 = i;
            while (i < h.length && h[i] != 61 && h[i] != 59) i++;      /* = ; */
            int s1 = i;
            String nm = Str.trim(Str.sub(h, s0, s1 - s0));
            if (i < h.length && h[i] == 61) i++;
            int v0 = i;
            while (i < h.length && h[i] != 59) i++;
            int v1 = i;
            if (nm == name) return Str.trim(Str.sub(h, v0, v1 - v0));
        }
        return "";
    }

    /* baris Set-Cookie; maxAge < 0 → tanpa Max-Age */
    static String setCookie(String name, String value, String path, int maxAge) {
        String s = "Set-Cookie: " + name + "=" + value + "; Path=" + path;
        if (maxAge >= 0) s = s + "; Max-Age=" + Str.fromInt(maxAge);
        return s + "\r\n";
    }

    /* decode body chunked (permintaan upload) */
    static int hexv2(int c) {
        if (c >= 48 && c <= 57) return c - 48;
        if (c >= 65 && c <= 70) return c - 55;
        if (c >= 97 && c <= 102) return c - 87;
        return -1;
    }

    static int[] dechunk(int[] raw) {
        int[] out = new int[raw.length];
        int o = 0;
        int i = 0;
        while (i < raw.length) {
            int e = i;
            while (e < raw.length && raw[e] != 13 && raw[e] != 10) e++;
            int size = 0;
            int any = 0;
            int k = i;
            while (k < e) {
                int h = hexv2(raw[k]);
                if (h < 0) break;
                size = size * 16 + h;
                any = 1;
                k++;
            }
            if (any == 0 || size == 0) break;
            int s0 = e;
            while (s0 < raw.length && (raw[s0] == 13 || raw[s0] == 10)) s0++;
            int cnt = size;
            if (s0 + cnt > raw.length) cnt = raw.length - s0;
            for (int j = 0; j < cnt; j++) { out[o] = raw[s0 + j]; o++; }
            i = s0 + cnt;
            while (i < raw.length && (raw[i] == 13 || raw[i] == 10)) i++;
        }
        return Bytes.slice(out, 0, o);
    }

    /* body permintaan: chunked bila Transfer-Encoding: chunked */
    static int[] bodyAny(int[] req) {
        String te = headerValue(req, "Transfer-Encoding");
        if (Str.equalsIgnoreCase(te, "chunked")) {
            int he = Bytes.indexOf(req, CRLF2(), 0);
            if (he < 0) return new int[0];
            return dechunk(Bytes.slice(req, he + 4, req.length - he - 4));
        }
        return body(req);
    }

    static int send(int fd, int[] resp) {
        return Net.sendb(fd, resp);
    }
}
