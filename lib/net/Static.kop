// Static.kop — penyajian file statis minimal di atas File (v1.9.2).
import File;
import Bytes;
import Str;
import HttpServer;
import Mime;
import Compress;

class Static {

    /* kompatibilitas: dulu ada di Static, kini delegasi ke Mime */
    static String mime(String path) { return Mime.of(path); }

    /* sajikan file; tolak path traversal "..". */
    static int[] serve(String path) {
        if (Str.contains(path, "..")) return HttpServer.forbidden();
        int fd = File.openRead(path);
        if (fd < 0) return HttpServer.notFound();
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Bytes.slice(body, 0, n);
        return HttpServer.response(200, Mime.of(path), body);
    }

    static String etag(int[] body) {
        return "\"" + Str.fromUInt(Compress.crc32(body)) + "-"
             + Str.fromInt(body.length) + "\"";
    }

    static boolean notModified(int[] req, String tag) {
        String v = HttpServer.headerValue(req, "If-None-Match");
        return v.length > 0 && Str.eq(v, tag);
    }

    /* respons file dengan ETag, Range, dan 304 (v1.24) */
    static int[] serveReqKA(int[] req, String path, int keep) {
        if (Str.contains(path, ".."))
            return HttpServer.responseKA(403, "text/plain; charset=utf-8", "forbidden\n", keep);
        String p = path;
        if (p.length == 0 || p[p.length - 1] == 47) p = p + "index.html";   /* '/' */
        int fd = File.openRead(p);
        if (fd < 0)
            return HttpServer.responseKA(404, "text/plain; charset=utf-8", "not found\n", keep);
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Bytes.slice(body, 0, n);
        String tag = etag(body);
        if (notModified(req, tag)) {
            String extra = "ETag: " + tag + "\r\nCache-Control: no-cache\r\n";
            return HttpServer.respond(304, Mime.of(p), new int[0], extra, keep);
        }
        int[] rr = HttpServer.rangeOf(req, body.length);
        String extra2 = "ETag: " + tag + "\r\nCache-Control: no-cache\r\n"
                      + "Accept-Ranges: bytes\r\n";
        if (rr.length > 0) {
            int start = rr[0];
            int end = rr[1];
            int[] part = Bytes.slice(body, start, end - start + 1);
            String extra3 = extra2 + "Content-Range: bytes " + Str.fromInt(start)
                          + "-" + Str.fromInt(end) + "/" + Str.fromInt(body.length) + "\r\n";
            return HttpServer.respond(206, Mime.of(p), part, extra3, keep);
        }
        return HttpServer.respond(200, Mime.of(p), body, extra2, keep);
    }

    static int[] serveReq(int[] req, String path) { return serveReqKA(req, path, 0); }

    /* varian keep-alive */
    static int[] serveKA(String path, int keep) {
        if (Str.contains(path, "..")) {
            return HttpServer.responseKA(403, "text/plain; charset=utf-8",
                                         "forbidden\n", keep);
        }
        int fd = File.openRead(path);
        if (fd < 0) {
            return HttpServer.responseKA(404, "text/plain; charset=utf-8",
                                         "not found\n", keep);
        }
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Bytes.slice(body, 0, n);
        return HttpServer.responseKA(200, Mime.of(path), body, keep);
    }
}
