// Static.kop — penyajian file statis minimal di atas File (v1.9.2).
import File;
import Path;
import Str;
import HttpServer;
import Mime;

class Static {

    /* kompatibilitas: dulu ada di Static, kini delegasi ke Mime */
    static int[] mime(int[] path) { return Mime.of(path); }

    /* sajikan file; tolak path traversal "..". */
    static int[] serve(int[] path) {
        if (Str.contains(path, Net.bytes(".."))) return HttpServer.forbidden();
        int fd = File.openRead(path);
        if (fd < 0) return HttpServer.notFound();
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Str.slice(body, 0, n);
        return HttpServer.response(200, Mime.of(path), body);
    }

    /* varian keep-alive */
    static int[] serveKA(int[] path, int keep) {
        if (Str.contains(path, Net.bytes(".."))) {
            return HttpServer.responseKA(403, Net.bytes("text/plain; charset=utf-8"),
                                         Net.bytes("forbidden\n"), keep);
        }
        int fd = File.openRead(path);
        if (fd < 0) {
            return HttpServer.responseKA(404, Net.bytes("text/plain; charset=utf-8"),
                                         Net.bytes("not found\n"), keep);
        }
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Str.slice(body, 0, n);
        return HttpServer.responseKA(200, Mime.of(path), body, keep);
    }
}
