// Static.kop — penyajian file statis minimal di atas File (v1.9).
import File;
import Path;
import Str;
import HttpServer;

class Static {

    static int[] mime(int[] path) {
        int[] e = Path.ext(path);
        if (Str.equalsIgnoreCase(e, Net.bytes("html"))) return Net.bytes("text/html; charset=utf-8");
        if (Str.equalsIgnoreCase(e, Net.bytes("htm")))  return Net.bytes("text/html; charset=utf-8");
        if (Str.equalsIgnoreCase(e, Net.bytes("css")))  return Net.bytes("text/css");
        if (Str.equalsIgnoreCase(e, Net.bytes("js")))   return Net.bytes("application/javascript");
        if (Str.equalsIgnoreCase(e, Net.bytes("json"))) return Net.bytes("application/json");
        if (Str.equalsIgnoreCase(e, Net.bytes("txt")))  return Net.bytes("text/plain; charset=utf-8");
        if (Str.equalsIgnoreCase(e, Net.bytes("png")))  return Net.bytes("image/png");
        if (Str.equalsIgnoreCase(e, Net.bytes("jpg")))  return Net.bytes("image/jpeg");
        if (Str.equalsIgnoreCase(e, Net.bytes("svg")))  return Net.bytes("image/svg+xml");
        if (Str.equalsIgnoreCase(e, Net.bytes("ico")))  return Net.bytes("image/x-icon");
        return Net.bytes("application/octet-stream");
    }

    /* sajikan file; tolak path traversal "..". */
    static int[] serve(int[] path) {
        if (Str.contains(path, Net.bytes(".."))) return HttpServer.forbidden();
        int fd = File.openRead(path);
        if (fd < 0) return HttpServer.notFound();
        int sz = File.size(fd);
        if (sz < 0) sz = 0;
        int[] body = new int[sz];
        int n = 0;
        if (sz > 0) n = File.readInto(fd, body);
        File.close(fd);
        if (n < 0) n = 0;
        if (n != sz) body = Str.slice(body, 0, n);
        return HttpServer.response(200, mime(path), body);
    }
}
