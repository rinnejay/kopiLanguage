/* Http.kop — klien HTTP untuk Kopi (v1.9.2).
 *
 * Di atas Tcp (yang di atas builtin `Net`). API lama (v1, HTTP/1.0,
 * Connection: close) tetap kompatibel; v1.9.2 menambahkan HTTP/1.1:
 * decode `Transfer-Encoding: chunked`, redirect 301/302/303/307/308,
 * basic auth, form/JSON POST, dan timeout socket 5 detik.
 *
 * Pemisahan galat yang rapi:
 *   - getInto() → total byte respons (≥ 0) atau kode galat negatif
 *   - statusOf() → kode status HTTP (200, 404, ...) atau -1 bila
 *     jawaban tidak berbentuk baris status yang normal
 *
 * Konstanta byte demi kejelasan: 13 = '\r', 32 = ' ', 48..57 = digit.
 */

import Str;
import Tcp;
import Url;
import Cipher;
import Tls;
import Compress;

class Http {

    /* ── permintaan ─────────────────────────────────────────────── */

    /* susun baris permintaan GET lengkap:
     *   "GET <path> HTTP/1.0\r\nHost: <host>\r\n\r\n" */
    static String req(String host, String path) {
        return "GET " + path + " HTTP/1.0\r\nHost: " + host + "\r\n\r\n";
    }

    /* ── respons ────────────────────────────────────────────────── */

    /* kode status HTTP dari baris pertama ("HTTP/1.0 200 OK"),
     * -1 bila tidak cocol dengan format baris status */
    static int statusOf(int[] resp) {
        if (resp.length < 12) return -1;      /* "HTTP/1.0 " sudah 10 byte */
        int n = Tcp.indexOf(resp, Net.bytes(" "), 0);
        if (n < 0) return -1;
        int code = 0;
        int ada = 0;
        for (int i = n + 1; i < resp.length; i++) {
            int c = resp[i];
            if (c == 32) break;               /* spasi menyusul kode */
            if (c < 48 || c > 57) return -1;  /* bukan digit: redi */
            code = code * 10 + (c - 48);
            ada = 1;
        }
        if (ada == 0 || code == 0) return -1;
        return code;
    }

    /* isi (body) respons: semua byte setelah pemisah CRLF CRLF.
     * tanpa pemisah (jawaban tak utuh) → seluruh respons dibalikkan. */
    static int[] bodyOf(int[] resp) {
        int p = Tcp.indexOf(resp, Net.bytes("\r\n\r\n"), 0);
        if (p < 0) return resp;
        return Tcp.tail(resp, p + 4);
    }

    /* ── GET satu putaran ───────────────────────────────────────── */

    /* kirim GET dan muat SELURUH respons (header + body) ke buf.
     * sukses → total byte respons (≥ 0); gagal → kode negatif.
     * buf terlalu kecil → respons terpotong (batas v1 tercatat). */
    static int getInto(int addr, int port, String host, String path, int[] buf) {
        int fd = Tcp.open(addr, port);
        if (fd < 0) return fd;
        int r = Tcp.sendBuf(fd, req(host, path));
        if (r < 0) {
            Net.close(fd);
            return r;
        }
        int n = Tcp.recvAll(fd, buf);
        Net.close(fd);
        return n;
    }

    /* ── POST satu putaran ──────────────────────────────────────── */

    /* kirim POST dengan body (Content-Length dari Tcp.num), muat
     * SELURUH respons ke buf — semantik sama dengan getInto. */
    static int postInto(int addr, int port, String host, String path,
                        int[] body, int[] buf) {
        int fd = Tcp.open(addr, port);
        if (fd < 0) return fd;
        String head = "POST " + path + " HTTP/1.0\r\nHost: " + host
                    + "\r\nContent-Type: text/plain\r\nContent-Length: "
                    + Str.fromInt(body.length) + "\r\n\r\n";
        int r = Tcp.sendBuf(fd, head);
        if (r == 0) r = Tcp.sendBuf(fd, body);
        if (r < 0) {
            Net.close(fd);
            return r;
        }
        int n = Tcp.recvAll(fd, buf);
        Net.close(fd);
        return n;
    }

    /* kenyamanan: GET lalu langsung ke body. galat ditandai array
     * hasil [0] = kode negatif (body tidak mungkin negatif). */
    static int[] body(int addr, int port, String host, String path, int cap) {
        int[] buf = new int[cap];
        int n = getInto(addr, port, host, path, buf);
        if (n < 0) {
            int[] err = new int[1];
            err[0] = n;
            return err;
        }
        int[] resp = new int[n];
        for (int i = 0; i < n; i++) resp[i] = buf[i];
        return bodyOf(resp);
    }

    /* ── header permintaan (v1.6.2) ─────────────────────────────── */

    /* kirim permintaan generik dengan header tambahan.
     * `headers` berisi baris mentah "Nama: nilai\r\n" (boleh kosong).
     * body kosong (length 0) → tanpa Content-Length (GET/HEAD).
     * HTTP/1.0: server menutup koneksi setelah respons. */
    static String reqEx(String method, String host, String path,
                        String headers, int[] body) {
        String out = method + " " + path + " HTTP/1.0\r\nHost: " + host + "\r\n";
        if (headers.length > 0) out = out + headers;
        if (body.length > 0) out = out + "Content-Length: " + Str.fromInt(body.length) + "\r\n";
        return out + "\r\n";
    }

    /* satu putaran penuh dengan method/header/body bebas. */
    static int requestInto(int addr, int port, String method, String host,
                           String path, String headers, int[] body, int[] buf) {
        int fd = Tcp.open(addr, port);
        if (fd < 0) return fd;
        int[] head = reqEx(method, host, path, headers, body);
        int r = Tcp.sendBuf(fd, head);
        if (r == 0 && body.length > 0) r = Tcp.sendBuf(fd, body);
        if (r < 0) {
            Net.close(fd);
            return r;
        }
        int n = Tcp.recvAll(fd, buf);
        Net.close(fd);
        return n;
    }

    /* GET dengan header tambahan */
    static int getWith(int addr, int port, String host, String path,
                       String headers, int[] buf) {
        return requestInto(addr, port, "GET", host, path,
                           headers, new int[0], buf);
    }

    /* POST dengan header tambahan + body */
    static int postWith(int addr, int port, String host, String path,
                        String headers, int[] body, int[] buf) {
        return requestInto(addr, port, "POST", host, path,
                           headers, body, buf);
    }

    /* ── pembacaan header respons ──────────────────────────────── */

    /* indeks awal body (setelah CRLF CRLF), -1 bila tidak ada */
    static int bodyStart(int[] resp) {
        int p = Tcp.indexOf(resp, Net.bytes("\r\n\r\n"), 0);
        if (p < 0) return -1;
        return p + 4;
    }

    /* potongan header mentah (tanpa baris status & tanpa CRLF CRLF) */
    static int[] headerBlock(int[] resp) {
        int e = Tcp.indexOf(resp, Net.bytes("\r\n\r\n"), 0);
        if (e < 0) return new int[0];
        int s0 = Tcp.indexOf(resp, Net.bytes("\r\n"), 0);
        if (s0 < 0 || s0 + 2 > e) return new int[0];
        int len = e - (s0 + 2);
        int[] out = new int[len];
        for (int i = 0; i < len; i++) out[i] = resp[s0 + 2 + i];
        return out;
    }

    static int lowerc(int c) {
        if (c >= 65 && c <= 90) return c + 32;
        return c;
    }

    static boolean nameEq(String line, int at, String name) {
        if (at + name.length > line.length) return false;
        for (int i = 0; i < name.length; i++) {
            if (lowerc(line[at + i]) != lowerc(name[i])) return false;
        }
        return true;
    }

    /* nilai header (tanpa spasi tepi), array kosong bila tidak ada.
     * perbandingan nama case-insensitive; baris pertama yang cocok dipakai. */
    static String headerValue(int[] resp, String name) {
        String block = Net.mkstr(headerBlock(resp));
        int i = 0;
        while (i < block.length) {
            int ls = i;
            while (i < block.length && block[i] != 13 && block[i] != 10) i++;
            int le = i;
            if (nameEq(block, ls, name) && ls + name.length < le &&
                block[ls + name.length] == 58) {          /* ':' */
                int vs = ls + name.length + 1;
                while (vs < le && (block[vs] == 32 || block[vs] == 9)) vs++;
                return Str.trim(Str.sub(block, vs, le - vs));
            }
            /* lewati CRLF */
            while (i < block.length && (block[i] == 13 || block[i] == 10)) i++;
        }
        return "";
    }

    static boolean hasHeader(int[] resp, String name) {
        return headerValue(resp, name).length > 0;
    }

    /* ═══ v1.9.2: HTTP/1.1 — chunked, redirect, form, auth ═══════ */

    static int hexVal(int c) {
        if (c >= 48 && c <= 57) return c - 48;
        if (c >= 65 && c <= 70) return c - 55;
        if (c >= 97 && c <= 102) return c - 87;
        return -1;
    }

    /* cari token (case-insensitive) di nilai header */
    static boolean hasToken(int[] resp, String name, String tok) {
        String v = headerValue(resp, name);
        if (v.length == 0) return false;
        int n = tok.length;
        for (int i = 0; i + n <= v.length; i++) {
            boolean ok = true;
            for (int j = 0; j < n; j++) {
                int a = v[i + j];
                int b = tok[j];
                if (a >= 65 && a <= 90) a = a + 32;
                if (b >= 65 && b <= 90) b = b + 32;
                if (a != b) { ok = false; break; }
            }
            if (ok) return true;
        }
        return false;
    }

    /* decode Transfer-Encoding: chunked (hex-size CRLF data CRLF ... 0) */
    static int[] dechunk(int[] raw) {
        int[] out = new int[raw.length];
        int o = 0;
        int i = 0;
        while (i < raw.length) {
            int e = i;
            while (e < raw.length && raw[e] != 13 && raw[e] != 10) e++;
            int size = 0;
            int any = 0;
            int k = i;
            while (k < e) {
                int h = hexVal(raw[k]);
                if (h < 0) break;              /* ';' ekstensi / spasi */
                size = size * 16 + h;
                any = 1;
                k++;
            }
            if (any == 0 || size == 0) break;
            int s0 = e;
            while (s0 < raw.length && (raw[s0] == 13 || raw[s0] == 10)) s0++;
            int cnt = size;
            if (s0 + cnt > raw.length) cnt = raw.length - s0;
            for (int j = 0; j < cnt; j++) { out[o] = raw[s0 + j]; o++; }
            i = s0 + cnt;
            while (i < raw.length && (raw[i] == 13 || raw[i] == 10)) i++;
        }
        int[] r = new int[o];
        for (int j = 0; j < o; j++) r[j] = out[j];
        return r;
    }

    /* body sebenarnya: chunked → decode; Content-Length → potong */
    static int[] payload(int[] resp) {
        int[] b = bodyOf(resp);
        if (hasToken(resp, "Transfer-Encoding", "chunked"))
            return dechunk(b);
        String cl = headerValue(resp, "Content-Length");
        if (cl.length > 0) {
            int n = Str.toInt(cl);
            if (n >= 0 && n < b.length) {
                int[] r = new int[n];
                for (int i = 0; i < n; i++) r[i] = b[i];
                return r;
            }
        }
        return b;
    }

    /* body setelah dekompresi Content-Encoding (gzip/deflate) */
    static int[] payloadDecoded(int[] resp) {
        int[] p = payload(resp);
        if (hasToken(resp, "Content-Encoding", "gzip"))
            return Compress.gunzip(p);
        if (hasToken(resp, "Content-Encoding", "deflate")) {
            int[] z = Compress.unzlib(p);
            if (z.length > 0) return z;
            return Compress.inflateRaw(p, p.length * 128 + 1024);
        }
        return p;
    }

    /* susun permintaan HTTP/1.1 (keep=1 → keep-alive, else close) */
    static String req11(String method, String hostHdr, String path,
                        String headers, int[] body, int keep) {
        String out = method + " " + path + " HTTP/1.1\r\nHost: " + hostHdr + "\r\n";
        if (headers.length > 0) out = out + headers;
        if (body.length > 0 || method.length == 4)
            out = out + "Content-Length: " + Str.fromInt(body.length) + "\r\n";
        if (keep != 0) out = out + "Connection: keep-alive\r\n";
        else out = out + "Connection: close\r\n";
        return out + "\r\n";
    }

    /* satu transaksi (core); timeoutMs > 0 memasang SO_RCVTIMEO/SO_SNDTIMEO */
    static int[] exchangeDo(int fd, String method, String hostHdr, String path,
                             String headers, int[] body, int cap, int timeoutMs) {
        if (timeoutMs > 0) Net.settimeout(fd, timeoutMs);
        int[] head = req11(method, hostHdr, path, headers, body, 0);
        int r = Tcp.sendBuf(fd, head);
        if (r == 0 && body.length > 0) r = Tcp.sendBuf(fd, body);
        if (r < 0) {
            int[] e = new int[1];
            e[0] = r;
            return e;
        }
        int[] buf = new int[cap];
        int n = Tcp.recvAll(fd, buf);
        if (n <= 0) {
            int[] e = new int[1];
            e[0] = -1;
            return e;
        }
        int[] resp = new int[n];
        for (int i = 0; i < n; i++) resp[i] = buf[i];
        return resp;
    }

    /* satu transaksi; timeoutMs > 0 memasang SO_RCVTIMEO/SO_SNDTIMEO */
    static int[] exchange(int addr, int port, String method, String hostHdr,
                          String path, String headers, int[] body, int cap) {
        int fd = Tcp.open(addr, port);
        if (fd < 0) {
            int[] e = new int[1];
            e[0] = fd;
            return e;
        }
        int[] resp = exchangeDo(fd, method, hostHdr, path, headers, body, cap, 5000);
        Net.close(fd);
        return resp;
    }

    static int[] getFull(int addr, int port, String hostHdr, String path, int cap) {
        return exchange(addr, port, "GET", hostHdr, path,
                        "", new int[0], cap);
    }

    static int[] getFullT(int addr, int port, String hostHdr, String path, int cap,
                          int timeoutMs) {
        int fd = Tcp.open(addr, port);
        if (fd < 0) {
            int[] e = new int[1];
            e[0] = fd;
            return e;
        }
        int[] resp = exchangeDo(fd, "GET", hostHdr, path, "", new int[0], cap, timeoutMs);
        Net.close(fd);
        return resp;
    }

    /* ikuti 301/302/303/307/308 (maks maxHops, host harus sama) */
    static int[] followT(int addr, int port, String hostHdr, String path,
                         int maxHops, int cap, int timeoutMs) {
        int[] resp = getFullT(addr, port, hostHdr, path, cap, timeoutMs);
        int hops = 0;
        while (hops < maxHops) {
            int st = statusOf(resp);
            if (st != 301 && st != 302 && st != 303 && st != 307 && st != 308) return resp;
            String loc = headerValue(resp, "Location");
            if (loc.length == 0) return resp;
            String base = "http://" + hostHdr + path;
            String nu = Url.resolve(base, loc);
            String nh = Url.host(nu);
            if (nh != hostHdr) return resp;               /* host lain: berhenti */
            int np = Url.portOf(nu, port);
            String npath = Url.path(nu);
            if (npath.length == 0) npath = "/";
            String q = Url.query(nu);
            if (q.length > 0) npath = npath + "?" + q;
            resp = getFullT(addr, np, hostHdr, npath, cap, timeoutMs);
            hops++;
        }
        return resp;
    }

    static int[] follow(int addr, int port, String hostHdr, String path,
                        int maxHops, int cap) {
        return followT(addr, port, hostHdr, path, maxHops, cap, 5000);
    }

    /* header "Authorization: Basic ..." dari user:pass */
    static String basic(String user, String pass) {
        return "Authorization: Basic " + Cipher.b64enc(user + ":" + pass) + "\r\n";
    }

    static int[] formPostT(int addr, int port, String hostHdr, String path,
                           String form, int cap, int timeoutMs) {
        String h = "Content-Type: application/x-www-form-urlencoded\r\n";
        int fd = Tcp.open(addr, port);
        if (fd < 0) { int[] e = new int[1]; e[0] = fd; return e; }
        int[] resp = exchangeDo(fd, "POST", hostHdr, path, h, form, cap, timeoutMs);
        Net.close(fd);
        return resp;
    }

    static int[] formPost(int addr, int port, String hostHdr, String path,
                          String form, int cap) {
        String h = "Content-Type: application/x-www-form-urlencoded\r\n";
        int fd = Tcp.open(addr, port);
        if (fd < 0) { int[] e = new int[1]; e[0] = fd; return e; }
        int[] resp = exchangeDo(fd, "POST", hostHdr, path, h, form, cap, 5000);
        Net.close(fd);
        return resp;
    }

    static int[] jsonPostT(int addr, int port, String hostHdr, String path,
                           String jsonBody, int cap, int timeoutMs) {
        String h = "Content-Type: application/json\r\n";
        int fd = Tcp.open(addr, port);
        if (fd < 0) { int[] e = new int[1]; e[0] = fd; return e; }
        int[] resp = exchangeDo(fd, "POST", hostHdr, path, h, jsonBody, cap, timeoutMs);
        Net.close(fd);
        return resp;
    }

    static int[] jsonPost(int addr, int port, String hostHdr, String path,
                          String jsonBody, int cap) {
        String h = "Content-Type: application/json\r\n";
        int fd = Tcp.open(addr, port);
        if (fd < 0) { int[] e = new int[1]; e[0] = fd; return e; }
        int[] resp = exchangeDo(fd, "POST", hostHdr, path, h, jsonBody, cap, 5000);
        Net.close(fd);
        return resp;
    }

    /* ── iterasi header (v1.24) ────────────────────────────────── */

    static String[] headerLines(int[] resp) {
        String block = Net.mkstr(headerBlock(resp));
        String[] all = Str.lines(block);
        int n = 0;
        for (int i = 0; i < all.length; i++) if (Str.trim(all[i]).length > 0) n++;
        String[] out = new String[n];
        int k = 0;
        for (int i = 0; i < all.length; i++) {
            String ln = Str.trim(all[i]);
            if (ln.length == 0) continue;
            out[k] = ln;
            k++;
        }
        return out;
    }

    static int headerCount(int[] resp) { return headerLines(resp).length; }

    /* nama header pada baris ke-i (sebelum ':'), "" bila bukan header */
    static String headerNameAt(int[] resp, int idx) {
        String[] ls = headerLines(resp);
        if (idx < 0 || idx >= ls.length) return "";
        int c = Str.indexOf(ls[idx], ":", 0);
        if (c <= 0) return "";
        return Str.trim(Str.sub(ls[idx], 0, c));
    }

    static String headerValueAt(int[] resp, int idx) {
        String[] ls = headerLines(resp);
        if (idx < 0 || idx >= ls.length) return "";
        int c = Str.indexOf(ls[idx], ":", 0);
        if (c < 0) return "";
        return Str.trim(Str.sub(ls[idx], c + 1, ls[idx].length - c - 1));
    }

    static String headerLineAt(int[] resp, int idx) {
        String[] ls = headerLines(resp);
        if (idx < 0 || idx >= ls.length) return "";
        return ls[idx];
    }

    /* semua nilai header bernama sama, digabung dengan `sep` */
    static String headerAll(int[] resp, String name, String sep) {
        String[] ls = headerLines(resp);
        String out = "";
        for (int i = 0; i < ls.length; i++) {
            int c = Str.indexOf(ls[i], ":", 0);
            if (c <= 0) continue;
            String nm = Str.trim(Str.sub(ls[i], 0, c));
            if (!Str.equalsIgnoreCase(nm, name)) continue;
            String v = Str.trim(Str.sub(ls[i], c + 1, ls[i].length - c - 1));
            if (out.length > 0) out = out + sep;
            out = out + v;
        }
        return out;
    }

    /* ── multipart/form-data (v1.24) ───────────────────────────── */

    static String multipartType(String boundary) {
        return "Content-Type: multipart/form-data; boundary=" + boundary + "\r\n";
    }

    static String multipartBody(String boundary, String[] names, String[] values) {
        String out = "";
        int n = names.length;
        if (values.length < n) n = values.length;
        for (int i = 0; i < n; i++) {
            out = out + "--" + boundary + "\r\n";
            out = out + "Content-Disposition: form-data; name=\"" + names[i] + "\"\r\n\r\n";
            out = out + values[i] + "\r\n";
        }
        return out + "--" + boundary + "--\r\n";
    }

    static int[] multipartPost(int addr, int port, String hostHdr, String path,
                               String boundary, String[] names, String[] values,
                               int cap) {
        String body = multipartBody(boundary, names, values);
        return exchange(addr, port, "POST", hostHdr, path,
                        multipartType(boundary), body, cap);
    }

    /* ── HTTPS (TLS 1.3, TOFU/pin) ─────────────────────────────── */

    /* pin = 32 byte SHA-256 SPKI, atau array kosong untuk TOFU.
     * Mengembalikan respons mentah; [0] negatif bila gagal. */
    static int[] exchangeTlsDo(int[] ctx, String method, String hostHdr, String path,
                                String headers, int[] body, int cap, int timeoutMs) {
        if (ctx[0] < 0) {
            int[] e = new int[1];
            e[0] = ctx[0];
            return e;
        }
        int verified = 0;
        if (ctx[3] == 1) verified = 1;
        if (ctx[2] < 0) verified = 0;      /* ctx[2]=pinOk; -1 = TOFU tanpa pin */
        if (verified != 1) {
            Net.close(ctx[0]);
            int[] e = new int[1];
            e[0] = -2;
            return e;
        }
        if (timeoutMs > 0) Net.settimeout(ctx[0], timeoutMs);
        String head = req11(method, hostHdr, path, headers, body, 0);
        int r = Tls.writeApp(ctx, head);
        if (r == 0 && body.length > 0) r = Tls.writeApp(ctx, body);
        if (r < 0) {
            Net.close(ctx[0]);
            int[] e = new int[1];
            e[0] = r;
            return e;
        }
        int[] out = new int[cap];
        int n = 0;
        while (n < cap) {
            int[] part = Tls.readApp(ctx);
            if (part.length == 0) break;
            int take = part.length;
            if (n + take > cap) take = cap - n;
            for (int i = 0; i < take; i++) out[n + i] = part[i];
            n = n + take;
            if (n >= cap) break;
        }
        Net.close(ctx[0]);
        if (n == 0) {
            int[] e = new int[1];
            e[0] = -1;
            return e;
        }
        int[] resp = new int[n];
        for (int i = 0; i < n; i++) resp[i] = out[i];
        return resp;
    }

    static int[] getTls(int addr, int port, String hostHdr, String path,
                        int cap, int[] pin, int timeoutMs) {
        int[] ctx = Tls.gate(addr, port, pin);
        return exchangeTlsDo(ctx, "GET", hostHdr, path, "", new int[0], cap, timeoutMs);
    }

}
