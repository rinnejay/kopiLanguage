// Mime.kop — pemetaan ekstensi → Content-Type (v1.23).
// Dipakai Static.kop dan bisa dipakai server lain.

import Str;
import Path;

class Mime {

    static String of(String path) {
        String e = Path.ext(path);
        if (Str.equalsIgnoreCase(e, "html")) return "text/html; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "htm"))  return "text/html; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "css"))  return "text/css; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "js"))   return "application/javascript";
        if (Str.equalsIgnoreCase(e, "mjs"))  return "application/javascript";
        if (Str.equalsIgnoreCase(e, "json")) return "application/json";
        if (Str.equalsIgnoreCase(e, "xml"))  return "application/xml";
        if (Str.equalsIgnoreCase(e, "txt"))  return "text/plain; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "md"))   return "text/markdown; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "csv"))  return "text/csv; charset=utf-8";
        if (Str.equalsIgnoreCase(e, "svg"))  return "image/svg+xml";
        if (Str.equalsIgnoreCase(e, "png"))  return "image/png";
        if (Str.equalsIgnoreCase(e, "jpg"))  return "image/jpeg";
        if (Str.equalsIgnoreCase(e, "jpeg")) return "image/jpeg";
        if (Str.equalsIgnoreCase(e, "gif"))  return "image/gif";
        if (Str.equalsIgnoreCase(e, "webp")) return "image/webp";
        if (Str.equalsIgnoreCase(e, "ico"))  return "image/x-icon";
        if (Str.equalsIgnoreCase(e, "woff")) return "font/woff";
        if (Str.equalsIgnoreCase(e, "woff2"))return "font/woff2";
        if (Str.equalsIgnoreCase(e, "ttf"))  return "font/ttf";
        if (Str.equalsIgnoreCase(e, "wasm")) return "application/wasm";
        if (Str.equalsIgnoreCase(e, "pdf"))  return "application/pdf";
        if (Str.equalsIgnoreCase(e, "mp3"))  return "audio/mpeg";
        if (Str.equalsIgnoreCase(e, "mp4"))  return "video/mp4";
        if (Str.equalsIgnoreCase(e, "zip"))  return "application/zip";
        return "application/octet-stream";
    }
}
