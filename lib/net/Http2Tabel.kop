/* Http2Tabel.kop — tabel HPACK (RFC 7541) untuk Http2.kop.
 *
 * HASIL GENERATOR — jangan edit manual: tools/gen_http2.py
 *   - hufCode/hufLen : kode Huffman kanonik, 257 simbol (Appendix B)
 *   - stName/stVal   : tabel statik 61 entri (Appendix A), ASCII
 *   - stNameOff/stValOff : offset u16 per entri (62 = sentinel akhir)
 */
import Cipher;

class Http2Tabel {

    static int[] hufCode() {
        int[] b = Cipher.hexdec(
        "");
        int[] out = new int[257];
        for (int i = 0; i < 257; i++) {
            out[i] = ((b[4 * i] & 255) << 24) | ((b[4 * i + 1] & 255) << 16)
                | ((b[4 * i + 2] & 255) << 8) | (b[4 * i + 3] & 255);
        }
        return out;
    }

    static int[] hufLen() {
        return Cipher.hexdec(
        "");
    }

    static int[] stName() {
        return Cipher.hexdec(
        "");
    }

    static int[] stNameOff() {
        int[] b = Cipher.hexdec(
        "0000000a00110018001d0022002900300037003e0045004c0053005a0061006f007e008d009a00a000bb00be00c300d000dd00f001000110011e012e013b0147014d01510155015b01620166016a017201830190019801ab01b801bc01c401d001e201f501fa02010208021302190223023c024d0257025b025e026e");
        int[] out = new int[62];
        for (int i = 0; i < 62; i++) {
            out[i] = ((b[2 * i] & 255) << 8) | (b[2 * i + 1] & 255);
        }
        return out;
    }

    static int[] stVal() {
        return Cipher.hexdec(
        "474554504f53542f2f696e6465782e68746d6c687474706874747073323030323034323036333034343030343034353030677a69702c206465666c617465");
    }

    static int[] stValOff() {
        int[] b = Cipher.hexdec(
        "0000000000030007000800130017001c001f002200250028002b002e00310031003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e003e");
        int[] out = new int[62];
        for (int i = 0; i < 62; i++) {
            out[i] = ((b[2 * i] & 255) << 8) | (b[2 * i + 1] & 255);
        }
        return out;
    }
}
