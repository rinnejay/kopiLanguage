// Auth.kop — util header Authorization (v1.23).
// Menerima NILAI header (bukan seluruh request), mis.
//   String v = HttpServer.headerValue(req, "Authorization");
//   if (Auth.checkBasic(v, "budi", "rahasia")) { ... }

import Str;
import Cipher;

class Auth {

    static int spaceAt(String v) {
        for (int i = 0; i < v.length; i++) if (v[i] == 32) return i;
        return -1;
    }

    static String scheme(String v) {
        int s = spaceAt(v);
        if (s < 0) return v;
        return Str.sub(v, 0, s);
    }

    static String token(String v) {
        int s = spaceAt(v);
        if (s < 0) return "";
        int b = s;
        while (b < v.length && v[b] == 32) b++;
        return Str.sub(v, b, v.length - b);
    }

    static boolean same(String a, String b) {
        if (a.length != b.length) return false;
        int d = 0;
        for (int i = 0; i < a.length; i++) d = d | (a[i] ^ b[i]);
        return d == 0;
    }

    /* hasil "user:pass" dari Basic, kosong bila bukan Basic */
    static String basicRaw(String v) {
        if (!Str.equalsIgnoreCase(scheme(v), "Basic")) return "";
        return Cipher.b64dec(token(v));
    }

    static boolean checkBasic(String v, String user, String pass) {
        String raw = basicRaw(v);
        if (raw.length == 0) return false;
        int c = -1;
        for (int i = 0; i < raw.length; i++) if (raw[i] == 58) { c = i; break; }
        if (c < 0) return false;
        return same(Str.sub(raw, 0, c), user)
            && same(Str.sub(raw, c + 1, raw.length - c - 1), pass);
    }

    static String bearer(String v) {
        if (!Str.equalsIgnoreCase(scheme(v), "Bearer")) return "";
        return token(v);
    }

    /* baris header tantangan untuk 401 */
    static String challenge(String realm) {
        return "WWW-Authenticate: Basic realm=\"" + realm + "\"\r\n";
    }
}
