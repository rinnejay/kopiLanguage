// Path.kop — operasi path berbasis String (v1.23).
import Str;

class Path {
    static int SEP() { return 47; }
    static String sep() { return "/"; }

    static String join(String a, String b) {
        if (a.length == 0) return b;
        if (b.length == 0) return a;
        if (a[a.length - 1] == 47) return a + b;
        return a + "/" + b;
    }

    static String base(String p) {
        int i = p.length - 1;
        while (i >= 0 && p[i] != 47) i--;
        return Str.sub(p, i + 1, p.length - i - 1);
    }

    static String dir(String p) {
        int i = p.length - 1;
        while (i >= 0 && p[i] != 47) i--;
        if (i < 0) return ".";
        if (i == 0) return "/";
        return Str.sub(p, 0, i);
    }

    static String ext(String p) {
        String b = base(p);
        int i = b.length - 1;
        while (i >= 0 && b[i] != 46) i--;
        if (i < 0) return "";
        return Str.sub(b, i + 1, b.length - i - 1);
    }

    static boolean isAbsolute(String p) { return p.length > 0 && p[0] == 47; }
}
