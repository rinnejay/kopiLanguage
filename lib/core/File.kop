// File.kop — file I/O di atas builtin Net (path String) v1.23.
// Flag openat standar Linux; mode 0644 = 420.

class File {
    static int O_RDONLY() { return 0; }
    static int O_WRONLY() { return 1; }
    static int O_CREAT()  { return 64; }
    static int O_TRUNC()  { return 512; }
    static int O_APPEND() { return 1024; }
    static int MODE_0644() { return 420; }

    static int openRead(String path)  { return Net.openb(path, 0, 0); }
    static int create(String path)    { return Net.openb(path, 577, 420); }
    static int append(String path)    { return Net.openb(path, 1089, 420); }
    static int close(int fd)         { return Net.close(fd); }

    static int writeAll(int fd, int[] data) { return Net.sendb(fd, data); }
    static int readInto(int fd, int[] buf)  { return Net.recvb(fd, buf); }

    static int seekSet(int fd, int off) { return Net.seek(fd, off, 0); }
    static int seekCur(int fd, int off) { return Net.seek(fd, off, 1); }
    static int seekEnd(int fd, int off) { return Net.seek(fd, off, 2); }

    static int size(int fd) {
        int cur = Net.seek(fd, 0, 1);
        int end = Net.seek(fd, 0, 2);
        Net.seek(fd, cur, 0);
        return end;
    }

    static int remove(String path) { return Net.unlinkb(path); }
    static int renameTo(String oldp, String newp) { return Net.renameb(oldp, newp); }
    static int mkdir(String path) { return Net.mkdirb(path); }

    /* v1.17.1: I/O teks langsung — kode biasa tak perlu sentuh int[] */
    static String readText(String path) {
        int fd = openRead(path);
        if (fd < 0) return Net.mkstr(new int[0]);
        int n = size(fd);
        int[] buf = new int[n > 0 ? n : 1];
        int got = readInto(fd, buf);
        Net.close(fd);
        if (got < 0) got = 0;
        if (got > n) got = n;
        int[] out = new int[got];
        for (int i = 0; i < got; i++) out[i] = buf[i];
        return Net.mkstr(out);
    }

    static boolean writeText(String path, String text) {
        int fd = create(path);
        if (fd < 0) return false;
        writeAll(fd, text);
        Net.close(fd);
        return true;
    }
}
