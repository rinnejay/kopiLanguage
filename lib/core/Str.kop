// Str.kop — utilitas teks (byte-as-int) murni Kopi (v1.7).
// Teks direpresentasikan int[] berisi byte 0..255; versi ini ASCII +
// hitung UTF-8 sederhana (tanpa normalisasi/segmentation Unicode).

class Str {

    static int len(int[] s) { return s.length; }

    static boolean isEmpty(int[] s) { return s.length == 0; }

    static boolean eq(int[] a, int[] b) {
        if (a.length != b.length) return false;
        for (int i = 0; i < a.length; i++) if (a[i] != b[i]) return false;
        return true;
    }

    static int cmp(int[] a, int[] b) {
        int n = a.length;
        if (b.length < n) n = b.length;
        for (int i = 0; i < n; i++) {
            if (a[i] < b[i]) return -1;
            if (a[i] > b[i]) return 1;
        }
        if (a.length < b.length) return -1;
        if (a.length > b.length) return 1;
        return 0;
    }

    static int[] copy(int[] a) {
        int[] o = new int[a.length];
        for (int i = 0; i < a.length; i++) o[i] = a[i];
        return o;
    }

    static int[] cat(int[] a, int[] b) {
        int[] o = new int[a.length + b.length];
        int k = 0;
        for (int i = 0; i < a.length; i++) { o[k] = a[i]; k++; }
        for (int i = 0; i < b.length; i++) { o[k] = b[i]; k++; }
        return o;
    }

    static int[] slice(int[] s, int from, int n) {
        if (from < 0) from = 0;
        if (from > s.length) from = s.length;
        if (n < 0) n = 0;
        if (from + n > s.length) n = s.length - from;
        int[] o = new int[n];
        for (int i = 0; i < n; i++) o[i] = s[from + i];
        return o;
    }

    static int at(int[] s, int i) {
        if (i < 0 || i >= s.length) return -1;
        return s[i];
    }

    static int indexOf(int[] s, int[] ndl, int from) {
        if (ndl.length == 0) return from;
        int lim = s.length - ndl.length;
        for (int i = from; i <= lim; i++) {
            int j = 0;
            while (j < ndl.length && s[i + j] == ndl[j]) j++;
            if (j == ndl.length) return i;
        }
        return -1;
    }

    static int lastIndexOf(int[] s, int[] ndl) {
        int last = -1;
        int p = 0;
        while (true) {
            int q = indexOf(s, ndl, p);
            if (q < 0) break;
            last = q;
            p = q + 1;
        }
        return last;
    }

    static boolean contains(int[] s, int[] ndl) { return indexOf(s, ndl, 0) >= 0; }

    static boolean startsWith(int[] s, int[] p) {
        if (p.length > s.length) return false;
        for (int i = 0; i < p.length; i++) if (s[i] != p[i]) return false;
        return true;
    }

    static boolean endsWith(int[] s, int[] p) {
        if (p.length > s.length) return false;
        int off = s.length - p.length;
        for (int i = 0; i < p.length; i++) if (s[off + i] != p[i]) return false;
        return true;
    }

    /* v1.17: fungsi pembangun teks mengembalikan String (materialisasi
     * eksplisit via Net.mkstr). int[] tetap khusus buffer byte I/O. */
    static String trimLeft(int[] s) {
        int a = 0;
        while (a < s.length && (s[a] == 32 || s[a] == 9 || s[a] == 10 || s[a] == 13)) a++;
        return Net.mkstr(slice(s, a, s.length - a));
    }

    static String trimRight(int[] s) {
        int b = s.length;
        while (b > 0 && (s[b - 1] == 32 || s[b - 1] == 9 || s[b - 1] == 10 || s[b - 1] == 13)) b--;
        return Net.mkstr(slice(s, 0, b));
    }

    static String trim(int[] s) { return trimRight(trimLeft(s)); }

    static String upper(int[] s) {
        int[] o = copy(s);
        for (int i = 0; i < o.length; i++) if (o[i] >= 97 && o[i] <= 122) o[i] = o[i] - 32;
        return Net.mkstr(o);
    }

    static String lower(int[] s) {
        int[] o = copy(s);
        for (int i = 0; i < o.length; i++) if (o[i] >= 65 && o[i] <= 90) o[i] = o[i] + 32;
        return Net.mkstr(o);
    }

    static String repeat(int[] s, int n) {
        if (n <= 0) return Net.mkstr(new int[0]);
        int[] o = new int[s.length * n];
        int k = 0;
        for (int r = 0; r < n; r++)
            for (int i = 0; i < s.length; i++) { o[k] = s[i]; k++; }
        return Net.mkstr(o);
    }

    static String reverse(int[] s) {
        int[] o = new int[s.length];
        for (int i = 0; i < s.length; i++) o[i] = s[s.length - 1 - i];
        return Net.mkstr(o);
    }

    static String replaceByte(int[] s, int from, int to) {
        int[] o = copy(s);
        for (int i = 0; i < o.length; i++) if (o[i] == from) o[i] = to;
        return Net.mkstr(o);
    }

    static String replaceSeq(int[] s, int[] old, int[] nw) {
        if (old.length == 0) return Net.mkstr(copy(s));
        int[] o = new int[0];
        int i = 0;
        while (i < s.length) {
            if (i + old.length <= s.length) {
                int j = 0;
                while (j < old.length && s[i + j] == old[j]) j++;
                if (j == old.length) { o = cat(o, nw); i = i + old.length; continue; }
            }
            int[] one = new int[1];
            one[0] = s[i];
            o = cat(o, one);
            i++;
        }
        return Net.mkstr(o);
    }

    static int countByte(int[] s, int b) {
        int n = 0;
        for (int i = 0; i < s.length; i++) if (s[i] == b) n++;
        return n;
    }

    static int splitCount(int[] s, int sep) {
        if (s.length == 0) return 0;
        int n = 1;
        for (int i = 0; i < s.length; i++) if (s[i] == sep) n++;
        return n;
    }

    static String splitAt(int[] s, int sep, int idx) {
        int k = 0;
        int st = 0;
        for (int i = 0; i <= s.length; i++) {
            boolean end = i == s.length;
            boolean hit = false;
            if (!end && s[i] == sep) hit = true;
            if (end || hit) {
                if (k == idx) return Net.mkstr(slice(s, st, i - st));
                k++;
                st = i + 1;
            }
        }
        return Net.mkstr(new int[0]);
    }

    /* substring ala umum: potongan teks sebagai String (v1.17).
     * Str.slice tetap int[] untuk buffer byte I/O. */
    static String sub(int[] s, int from, int n) {
        return Net.mkstr(slice(s, from, n));
    }

    static String padLeft(int[] s, int width, int pad) {
        if (s.length >= width) return Net.mkstr(copy(s));
        int[] o = new int[width];
        int fill = width - s.length;
        for (int i = 0; i < fill; i++) o[i] = pad;
        for (int i = 0; i < s.length; i++) o[fill + i] = s[i];
        return Net.mkstr(o);
    }

    static String padRight(int[] s, int width, int pad) {
        if (s.length >= width) return Net.mkstr(copy(s));
        int[] o = new int[width];
        for (int i = 0; i < s.length; i++) o[i] = s[i];
        for (int i = s.length; i < width; i++) o[i] = pad;
        return Net.mkstr(o);
    }

    static String fromInt(int v) {
        boolean neg = v < 0;
        int n = v;
        if (neg) n = -n;
        int[] tmp = new int[12];
        int k = 0;
        if (n == 0) { tmp[0] = 48; k = 1; }
        while (n > 0) { tmp[k] = 48 + n % 10; k++; n = n / 10; }
        int off = 0;
        if (neg) off = 1;
        int[] o = new int[k + off];
        if (neg) o[0] = 45;
        for (int i = 0; i < k; i++) o[off + i] = tmp[k - 1 - i];
        return Net.mkstr(o);
    }

    static int toInt(int[] s) {
        int i = 0;
        boolean neg = false;
        if (i < s.length && s[i] == 45) { neg = true; i++; }
        int r = 0;
        while (i < s.length) {
            int c = s[i];
            if (c < 48 || c > 57) break;
            r = r * 10 + (c - 48);
            i++;
        }
        if (neg) r = -r;
        return r;
    }

    static boolean isDigits(int[] s) {
        if (s.length == 0) return false;
        for (int i = 0; i < s.length; i++) if (s[i] < 48 || s[i] > 57) return false;
        return true;
    }

    static boolean equalsIgnoreCase(int[] a, int[] b) {
        if (a.length != b.length) return false;
        for (int i = 0; i < a.length; i++) {
            int x = a[i];
            int y = b[i];
            if (x >= 65 && x <= 90) x = x + 32;
            if (y >= 65 && y <= 90) y = y + 32;
            if (x != y) return false;
        }
        return true;
    }

    static int utf8Count(int[] s) {
        int n = 0;
        for (int i = 0; i < s.length; i++) {
            if ((s[i] & 192) != 128) n++;
        }
        return n;
    }

    static int[] hex(int[] data) {
        int[] dig = new int[16];
        int k = 0;
        for (int i = 0; i < data.length; i++) {
            int v = data[i] & 255;
            int hi = v / 16;
            int lo = v % 16;
            if (hi < 10) dig[k] = 48 + hi; else dig[k] = 87 + hi;
            k++;
            if (lo < 10) dig[k] = 48 + lo; else dig[k] = 87 + lo;
            k++;
        }
        int[] o = new int[k];
        for (int i = 0; i < k; i++) o[i] = dig[i];
        return o;
    }

    /* ── konversi untuk template & umum (v1.7.1) ─────────────── */

    static String boolText(boolean b) {
        if (b) return Net.bytes("true");
        return Net.bytes("false");
    }

    /* uint32 (nilai kanonik zero-extended di int) */
    static String fromUInt(int v) {
        if (v >= 0) return fromInt(v);
        long u = ((long)v) & 4294967295L;
        return fromLong(u);
    }

    static String fromLong(long v) {
        boolean neg = v < 0;
        long n = v;
        int[] tmp = new int[24];
        int k = 0;
        if (n == 0) { tmp[0] = 48; k = 1; }
        while (n != 0) {
            long d = n % 10;
            if (d < 0) d = -d;
            tmp[k] = 48 + (int)d;
            k++;
            n = n / 10;
        }
        int off = 0;
        if (neg) off = 1;
        int[] o = new int[k + off];
        if (neg) o[0] = 45;
        for (int i = 0; i < k; i++) o[off + i] = tmp[k - 1 - i];
        return Net.mkstr(o);
    }

    /* uint64: divisi unsigned bit-per-bit */
    static String fromULong(long v) {
        if (v >= 0) return fromLong(v);
        int[] tmp = new int[24];
        int k = 0;
        long x = v;
        while (x != 0) {
            long q = 0;
            int rem = 0;
            for (int b = 63; b >= 0; b--) {
                rem = rem * 2 + (int)((x >>> b) & 1);
                q = q << 1;
                if (rem >= 10) { rem = rem - 10; q = q | 1; }
            }
            tmp[k] = 48 + rem;
            k++;
            x = q;
        }
        if (k == 0) { tmp[0] = 48; k = 1; }
        int[] o = new int[k];
        for (int i = 0; i < k; i++) o[i] = tmp[k - 1 - i];
        return Net.mkstr(o);
    }

    /* double → desimal sederhana (maks 6 digit pecahan, nol ekor dibuang).
     * Batas jujur: bukan algoritma pembulatan Java/printf. */
    static String fromDouble(double d) {
        boolean neg = d < 0.0;
        boolean isnan = d != d;
        double x = d;
        if (neg) x = -x;
        if (isnan) return Net.bytes("nan");
        if (x > 9000000000000000000.0) {
            if (neg) return Net.bytes("-inf");
            return Net.bytes("inf");
        }
        long ip = (long)x;
        String o = fromLong(ip);
        double frac = x - (double)ip;
        if (frac > 0.0000005) {
            int[] fd = new int[6];
            int k = 0;
            for (int i = 0; i < 6; i++) {
                frac = frac * 10.0;
                int dig = (int)frac;
                fd[k] = 48 + dig;
                k++;
                frac = frac - (double)dig;
            }
            while (k > 0 && fd[k - 1] == 48) k--;
            if (k > 0) {
                int[] fr = new int[k];
                for (int i = 0; i < k; i++) fr[i] = fd[i];
                o = o + Net.bytes(".") + Net.mkstr(fr);
            }
        }
        if (neg) o = Net.bytes("-") + o;
        return o;
    }

    static void print(int[] s) {
        for (int i = 0; i < s.length; i++) Net.wrb(1, s[i]);
    }

    static void line(int[] s) {
        print(s);
        Net.wrb(1, 10);
    }
}
