// Matrix.kop — aljabar matriks persegi di atas int[] datar (row-major).
//
// Matriks n×n disimpan sebagai int[n*n]: elemen (r,c) = a[r*n + c].
// Hanya matriks persegi agar API tidak butuh pasangan dimensi; fungsi
// determinan disediakan khusus 1×1..3×3 (ekspansi kofaktor).
// Semua operasi memakai aritmetika int 32-bit (bisa meluap — dokumentasi).

class Matrix {

    /* matriks nol n×n */
    static int[] zero(int n) {
        return new int[n * n];
    }

    /* matriks identitas n×n */
    static int[] identity(int n) {
        int[] a = new int[n * n];
        int i = 0;
        while (i < n) {
            a[i * n + i] = 1;
            i = i + 1;
        }
        return a;
    }

    static int get(int[] a, int n, int r, int c) {
        return a[r * n + c];
    }

    static void set(int[] a, int n, int r, int c, int v) {
        a[r * n + c] = v;
    }

    /* a + b (ukuran sama) */
    static int[] add(int[] a, int[] b) {
        int[] out = new int[a.length];
        for (int i = 0; i < a.length; i++) {
            out[i] = a[i] + b[i];
        }
        return out;
    }

    /* a − b */
    static int[] sub(int[] a, int[] b) {
        int[] out = new int[a.length];
        for (int i = 0; i < a.length; i++) {
            out[i] = a[i] - b[i];
        }
        return out;
    }

    /* k·a */
    static int[] scale(int[] a, int k) {
        int[] out = new int[a.length];
        for (int i = 0; i < a.length; i++) {
            out[i] = a[i] * k;
        }
        return out;
    }

    /* transpose n×n */
    static int[] transpose(int n, int[] a) {
        int[] out = new int[n * n];
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {
                out[c * n + r] = a[r * n + c];
            }
        }
        return out;
    }

    /* perkalian dua matriks n×n */
    static int[] mul(int n, int[] a, int[] b) {
        int[] out = new int[n * n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                int s = 0;
                for (int k = 0; k < n; k++) {
                    s = s + a[i * n + k] * b[k * n + j];
                }
                out[i * n + j] = s;
            }
        }
        return out;
    }

    /* jumlah elemen diagonal utama */
    static int trace(int n, int[] a) {
        int s = 0;
        for (int i = 0; i < n; i++) {
            s = s + a[i * n + i];
        }
        return s;
    }

    /* determinan 1×1 */
    static int det1(int[] a) {
        return a[0];
    }

    /* determinan 2×2 */
    static int det2(int[] a) {
        return a[0] * a[3] - a[1] * a[2];
    }

    /* determinan 3×3 (aturan Sarrus) */
    static int det3(int[] a) {
        return a[0] * (a[4] * a[8] - a[5] * a[7])
             - a[1] * (a[3] * a[8] - a[5] * a[6])
             + a[2] * (a[3] * a[7] - a[4] * a[6]);
    }

    /* determinan umum n<=3; di luar itu 0 (jujur: belum ada rekursi kofaktor
     * umum tanpa alokasi dinamis bersarang) */
    static int det(int n, int[] a) {
        if (n == 1) { return det1(a); }
        if (n == 2) { return det2(a); }
        if (n == 3) { return det3(a); }
        return 0;
    }

    /* apakah matriks identitas */
    static boolean isIdentity(int n, int[] a) {
        for (int r = 0; r < n; r++) {
            for (int c = 0; c < n; c++) {
                int want = 0;
                if (r == c) { want = 1; }
                if (a[r * n + c] != want) { return false; }
            }
        }
        return true;
    }
}
