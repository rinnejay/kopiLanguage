// Math.kop — pustaka matematika integer lengkap (100% bahasa Kopi).
//
// Cakupan: dasar, bit, pangkat/akar/log, aritmetika modular, teori bilangan,
// kombinatorika. Semua bekerja pada `int` 32-bit bertanda (semantik Java).
// CATATAN JUJUR: belum ada `double`/`long`, jadi tidak ada trigonometri,
// floating point, atau bilangan besar umum; hasil yang meluap akan membungkus
// (wrap) seperti aritmetika 32-bit biasa. Rentang aman ditulis per fungsi.
//
// Semua metode static; import Math; → Math.sqrt(100), dst.

class Math {

    /* ═══════════════ dasar ═══════════════ */

    static int abs(int x) {
        if (x < 0) { return -x; }
        return x;
    }

    /* tanda: -1, 0, +1 */
    static int sign(int x) {
        if (x < 0) { return -1; }
        if (x > 0) { return 1; }
        return 0;
    }

    static int min(int a, int b) {
        if (a < b) { return a; }
        return b;
    }

    static int max(int a, int b) {
        if (a > b) { return a; }
        return b;
    }

    static int min3(int a, int b, int c) {
        return min(min(a, b), c);
    }

    static int max3(int a, int b, int c) {
        return max(max(a, b), c);
    }

    /* batasi x ke [lo, hi] (lo <= hi) */
    static int clamp(int x, int lo, int hi) {
        if (x < lo) { return lo; }
        if (x > hi) { return hi; }
        return x;
    }

    /* |a - b| */
    static int diff(int a, int b) {
        return abs(a - b);
    }

    /* 1 + 2 + ... + n  (n >= 0; rumus Gauss) */
    static int sumTo(int n) {
        if (n <= 0) { return 0; }
        return n * (n + 1) / 2;
    }

    /* rata-rata dua bilangan tanpa overflow a+b */
    static int avgFloor(int a, int b) {
        return a + (b - a) / 2;
    }

    /* ═══════════════ paritas & bit ═══════════════ */

    static boolean isEven(int n) {
        return n % 2 == 0;
    }

    static boolean isOdd(int n) {
        return n % 2 != 0;
    }

    /* jumlah bit 1 dalam representasi 32-bit (two's complement) */
    static int popcount(int n) {
        int c = 0;
        int x = n;
        for (int i = 0; i < 32; i++) {
            c = c + (x & 1);
            x = x >>> 1;
        }
        return c;
    }

    /* posisi bit 1 tertinggi (0..31); -1 bila n == 0 */
    static int highestBit(int n) {
        if (n == 0) { return -1; }
        int x = n;
        int p = 0;
        while (x > 0) {
            p = p + 1;
            x = x >>> 1;
        }
        return p - 1;
    }

    /* posisi bit 1 terendah (0..31); -1 bila n == 0 */
    static int lowestBit(int n) {
        if (n == 0) { return -1; }
        int x = n;
        int p = 0;
        while ((x & 1) == 0 && p < 31) {
            p = p + 1;
            x = x >>> 1;
        }
        return p;
    }

    /* jumlah bit signifikan (0 untuk 0; negatif dianggap 32 bit) */
    static int bitLength(int n) {
        if (n == 0) { return 0; }
        if (n < 0) { return 32; }
        int x = n;
        int c = 0;
        while (x > 0) {
            c = c + 1;
            x = x >>> 1;
        }
        return c;
    }

    static boolean isPowerOfTwo(int n) {
        if (n <= 0) { return false; }
        return (n & (n - 1)) == 0;
    }

    /* pangkat dua terkecil >= n (n >= 1); 0 bila meluap */
    static int nextPow2(int n) {
        if (n <= 1) { return 1; }
        int r = 1;
        while (r < n) {
            if (r > 1073741823) { return 0; }
            r = r * 2;
        }
        return r;
    }

    /* pangkat dua terbesar <= n; 0 bila n < 1 */
    static int prevPow2(int n) {
        if (n < 1) { return 0; }
        int r = 1;
        while (r <= n / 2) {
            r = r * 2;
        }
        return r;
    }

    /* balik urutan 32 bit */
    static int reverseBits(int n) {
        int x = n;
        int r = 0;
        for (int i = 0; i < 32; i++) {
            r = (r << 1) | (x & 1);
            x = x >>> 1;
        }
        return r;
    }

    /* ═══════════════ pangkat, akar, log ═══════════════ */

    /* a^e (e >= 0); meluap membungkus */
    static int pow(int a, int e) {
        int r = 1;
        for (int i = 0; i < e; i++) {
            r = r * a;
        }
        return r;
    }

    /* sisa non-negatif: selalu 0 .. m-1 (m > 0) */
    static int mod(int a, int m) {
        if (m <= 0) { return -1; }
        int r = a % m;
        if (r < 0) { r = r + m; }
        return r;
    }

    /* (a+b) mod m, aman overflow */
    static int addMod(int a, int b, int m) {
        if (m <= 0) { return -1; }
        int x = mod(a, m);
        int y = mod(b, m);
        return mod(x + y, m);
    }

    /* (a*b) mod m tanpa overflow (doubling), m > 0 */
    static int mulMod(int a, int b, int m) {
        if (m <= 0) { return -1; }
        int x = mod(a, m);
        int y = mod(b, m);
        int r = 0;
        while (y > 0) {
            if ((y & 1) == 1) {
                if (r >= m - x) { r = r - (m - x); }
                else { r = r + x; }
            }
            if (x >= m - x) { x = x - (m - x); }
            else { x = x + x; }
            y = y >>> 1;
        }
        return r;
    }

    /* a^e mod m (fast exponentiation), e >= 0, m > 0 */
    static int powMod(int a, int e, int m) {
        if (m <= 0) { return -1; }
        int base = mod(a, m);
        int r = mod(1, m);
        int ee = e;
        while (ee > 0) {
            if ((ee & 1) == 1) { r = mulMod(r, base, m); }
            base = mulMod(base, base, m);
            ee = ee >>> 1;
        }
        return r;
    }

    /* akar kuadrat bulat ke bawah (n >= 0) */
    static int sqrt(int n) {
        if (n < 0) { return -1; }
        if (n < 2) { return n; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }

    /* akar pangkat tiga bulat ke bawah, tanda dipertahankan */
    static int cbrt(int n) {
        boolean neg = n < 0;
        int m = n;
        if (neg) { m = -m; }
        int lo = 0;
        int hi = 1290;
        while (lo < hi) {
            int mid = lo + (hi - lo + 1) / 2;
            if (mid == 0) { lo = 0; }
            else if (mid <= m / mid / mid) { lo = mid; }
            else { hi = mid - 1; }
        }
        if (neg) { return -lo; }
        return lo;
    }

    /* log2 bulat ke bawah (n >= 1) */
    static int log2(int n) {
        if (n < 1) { return -1; }
        int x = n;
        int c = 0;
        while (x > 1) {
            x = x / 2;
            c = c + 1;
        }
        return c;
    }

    /* log10 bulat ke bawah (n >= 1) */
    static int log10(int n) {
        if (n < 1) { return -1; }
        int x = n;
        int c = 0;
        while (x >= 10) {
            x = x / 10;
            c = c + 1;
        }
        return c;
    }

    static boolean isPerfectSquare(int n) {
        if (n < 0) { return false; }
        int r = sqrt(n);
        return r * r == n;
    }

    static boolean isPerfectCube(int n) {
        int c = cbrt(n);
        return c * c * c == n;
    }

    /* ═══════════════ FPB / KPK / modular ═══════════════ */

    static int gcd(int a, int b) {
        if (a < 0) { a = -a; }
        if (b < 0) { b = -b; }
        while (b != 0) {
            int t = a % b;
            a = b;
            b = t;
        }
        return a;
    }

    static int gcd3(int a, int b, int c) {
        return gcd(gcd(a, b), c);
    }

    /* KPK; bagi dulu supaya tidak mudah overflow */
    static int lcm(int a, int b) {
        if (a == 0 || b == 0) { return 0; }
        return abs(a) / gcd(a, b) * abs(b);
    }

    static int lcm3(int a, int b, int c) {
        return lcm(lcm(a, b), c);
    }

    static boolean isCoprime(int a, int b) {
        return gcd(a, b) == 1;
    }

    /* Bezout: hasil {g, x, y} dengan a*x + b*y = g = gcd(a,b) */
    static int[] extendedGcd(int a, int b) {
        int oldR = a;
        int r = b;
        int oldS = 1;
        int s = 0;
        int oldT = 0;
        int t = 1;
        while (r != 0) {
            int q = oldR / r;
            int nr = oldR - q * r;
            oldR = r;
            r = nr;
            int ns = oldS - q * s;
            oldS = s;
            s = ns;
            int nt = oldT - q * t;
            oldT = t;
            t = nt;
        }
        if (oldR < 0) {
            oldR = -oldR;
            oldS = -oldS;
            oldT = -oldT;
        }
        int[] out = new int[3];
        out[0] = oldR;
        out[1] = oldS;
        out[2] = oldT;
        return out;
    }

    /* invers a modulo m (m > 1); -1 bila tidak ada */
    static int modInverse(int a, int m) {
        if (m <= 1) { return -1; }
        int[] e = extendedGcd(a, m);
        if (e[0] != 1) { return -1; }
        return mod(e[1], m);
    }

    /* ═══════════════ prima & faktorisasi ═══════════════ */

    /* uji prima 6k±1; aman untuk seluruh int32 (pakai n/i) */
    static boolean isPrime(int n) {
        if (n < 2) { return false; }
        if (n < 4) { return true; }
        if (n % 2 == 0 || n % 3 == 0) { return false; }
        int i = 5;
        while (i <= n / i) {
            if (n % i == 0 || n % (i + 2) == 0) { return false; }
            i = i + 6;
        }
        return true;
    }

    /* prima berikutnya > n */
    static int nextPrime(int n) {
        int x = n + 1;
        if (x < 2) { x = 2; }
        if (x == 2) { return 2; }
        if (x % 2 == 0) { x = x + 1; }
        while (!isPrime(x)) {
            if (x > 2147483647 - 2) { return -1; }
            x = x + 2;
        }
        return x;
    }

    /* prima terbesar < n; -1 bila tidak ada */
    static int prevPrime(int n) {
        if (n <= 2) { return -1; }
        int x = n - 1;
        if (x == 2) { return 2; }
        if (x % 2 == 0) { x = x - 1; }
        while (x >= 3) {
            if (isPrime(x)) { return x; }
            x = x - 2;
        }
        return -1;
    }

    /* daftar prima <= n (sieve Eratosthenes) */
    static int[] primesUpTo(int n) {
        int[] kosong = new int[0];
        if (n < 2) { return kosong; }
        int[] mark = new int[n + 1];
        int i = 0;
        while (i <= n) {
            mark[i] = 1;
            i = i + 1;
        }
        mark[0] = 0;
        mark[1] = 0;
        int p = 2;
        while (p <= n / p) {
            if (mark[p] == 1) {
                int j = p * p;
                while (j <= n) {
                    mark[j] = 0;
                    j = j + p;
                }
            }
            p = p + 1;
        }
        int total = 0;
        i = 0;
        while (i <= n) {
            total = total + mark[i];
            i = i + 1;
        }
        int[] out = new int[total];
        int k = 0;
        i = 0;
        while (i <= n) {
            if (mark[i] == 1) {
                out[k] = i;
                k = k + 1;
            }
            i = i + 1;
        }
        return out;
    }

    /* banyaknya prima <= n (π(n)) */
    static int primeCount(int n) {
        return primesUpTo(n).length;
    }

    /* prima ke-k, k mulai 1 (2,3,5,...); 0 bila melampaui int */
    static int nthPrime(int k) {
        if (k < 1) { return 0; }
        int found = 0;
        int x = 1;
        while (found < k) {
            x = x + 1;
            if (isPrime(x)) { found = found + 1; }
            if (x > 2147483647 - 2) { return 0; }
        }
        return x;
    }

    /* faktor prima menaik dengan multiplisitas: 360 → {2,2,2,3,3,5} */
    static int[] factorize(int n) {
        int[] kosong = new int[0];
        if (n < 2) { return kosong; }
        int m = n;
        int[] buf = new int[64];
        int k = 0;
        while (m % 2 == 0 && k < 64) {
            buf[k] = 2;
            k = k + 1;
            m = m / 2;
        }
        int p = 3;
        while (p <= m / p) {
            while (m % p == 0 && k < 64) {
                buf[k] = p;
                k = k + 1;
                m = m / p;
            }
            p = p + 2;
        }
        if (m > 1 && k < 64) {
            buf[k] = m;
            k = k + 1;
        }
        int[] out = new int[k];
        int i = 0;
        while (i < k) {
            out[i] = buf[i];
            i = i + 1;
        }
        return out;
    }

    /* jumlah pembagi positif d(n) */
    static int numDivisors(int n) {
        if (n < 1) { return 0; }
        int m = n;
        int count = 1;
        int e = 0;
        while (m % 2 == 0) {
            m = m / 2;
            e = e + 1;
        }
        count = count * (e + 1);
        int p = 3;
        while (p <= m / p) {
            e = 0;
            while (m % p == 0) {
                m = m / p;
                e = e + 1;
            }
            if (e > 0) { count = count * (e + 1); }
            p = p + 2;
        }
        if (m > 1) { count = count * 2; }
        return count;
    }

    /* jumlah semua pembagi positif σ(n) */
    static int sumDivisors(int n) {
        if (n < 1) { return 0; }
        int m = n;
        int sigma = 1;
        int p = 2;
        while (p <= m / p) {
            if (m % p == 0) {
                int pw = 1;
                int term = 1;
                while (m % p == 0) {
                    m = m / p;
                    pw = pw * p;
                    term = term + pw;
                }
                sigma = sigma * term;
            }
            p = p + 1;
        }
        if (m > 1) { sigma = sigma * (1 + m); }
        return sigma;
    }

    /* jumlah pembagi sejati (kecuali n) */
    static int aliquotSum(int n) {
        if (n < 1) { return 0; }
        return sumDivisors(n) - n;
    }

    static boolean isPerfect(int n) {
        return n > 1 && aliquotSum(n) == n;
    }

    static boolean isAbundant(int n) {
        return aliquotSum(n) > n;
    }

    static boolean isDeficient(int n) {
        return aliquotSum(n) < n;
    }

    /* φ(n) Euler */
    static int eulerPhi(int n) {
        if (n < 1) { return 0; }
        int m = n;
        int phi = n;
        int p = 2;
        while (p <= m / p) {
            if (m % p == 0) {
                while (m % p == 0) { m = m / p; }
                phi = phi - phi / p;
            }
            p = p + 1;
        }
        if (m > 1) { phi = phi - phi / m; }
        return phi;
    }

    /* hasil kali faktor prima berbeda: 360 → 2*3*5 = 30 */
    static int radical(int n) {
        if (n < 1) { return 0; }
        int m = n;
        int r = 1;
        int p = 2;
        while (p <= m / p) {
            if (m % p == 0) {
                while (m % p == 0) { m = m / p; }
                r = r * p;
            }
            p = p + 1;
        }
        if (m > 1) { r = r * m; }
        return r;
    }

    /* fungsi Möbius μ(n) */
    static int mobius(int n) {
        if (n < 1) { return 0; }
        int m = n;
        int distinct = 0;
        int p = 2;
        while (p <= m / p) {
            if (m % p == 0) {
                m = m / p;
                distinct = distinct + 1;
                if (m % p == 0) { return 0; }
            }
            p = p + 1;
        }
        if (m > 1) { distinct = distinct + 1; }
        if (distinct % 2 == 0) { return 1; }
        return -1;
    }

    /* ═══════════════ kombinatorika ═══════════════ */

    static int factorial(int n) {
        if (n < 0) { return 0; }
        int r = 1;
        for (int i = 2; i <= n; i++) {
            r = r * i;
        }
        return r;
    }

    /* C(n,k) — perkalian eksak bertahap (aman selama hasil muat int) */
    static int binomial(int n, int k) {
        if (n < 0 || k < 0 || k > n) { return 0; }
        int kk = k;
        if (kk > n - kk) { kk = n - kk; }
        int r = 1;
        for (int i = 1; i <= kk; i++) {
            r = r * (n - kk + i) / i;
        }
        return r;
    }

    /* P(n,k) = n!/(n-k)! */
    static int permutation(int n, int k) {
        if (n < 0 || k < 0 || k > n) { return 0; }
        int r = 1;
        for (int i = 0; i < k; i++) {
            r = r * (n - i);
        }
        return r;
    }

    /* bilangan Catalan C(n) = C(2n,n)/(n+1) */
    static int catalan(int n) {
        if (n < 0) { return 0; }
        return binomial(2 * n, n) / (n + 1);
    }

    /* Fibonacci iteratif (n >= 0) */
    static int fib(int n) {
        if (n < 0) { return 0; }
        int a = 0;
        int b = 1;
        for (int i = 0; i < n; i++) {
            int c = a + b;
            a = b;
            b = c;
        }
        return a;
    }

    /* Lucas L(n): 2,1,3,4,7,11,... */
    static int lucas(int n) {
        if (n < 0) { return 0; }
        if (n == 0) { return 2; }
        int a = 2;
        int b = 1;
        for (int i = 1; i < n; i++) {
            int c = a + b;
            a = b;
            b = c;
        }
        return b;
    }

    /* Tribonacci: 0,0,1,1,2,4,7,13,... */
    static int tribonacci(int n) {
        if (n < 0) { return 0; }
        if (n == 0) { return 0; }
        if (n <= 2) { return 1; }
        int a = 0;
        int b = 0;
        int c = 1;
        for (int i = 3; i <= n; i++) {
            int d = a + b + c;
            a = b;
            b = c;
            c = d;
        }
        return c;
    }

    /* bilangan segitiga T(n) = n(n+1)/2 (n >= 0) */
    static int triangular(int n) {
        if (n < 0) { return 0; }
        return n * (n + 1) / 2;
    }

    /* derangement !n (subfaktorial) */
    static int derangement(int n) {
        if (n < 0) { return 0; }
        if (n == 0) { return 1; }
        if (n == 1) { return 0; }
        int d0 = 1;
        int d1 = 0;
        for (int i = 2; i <= n; i++) {
            int d2 = (i - 1) * (d1 + d0);
            d0 = d1;
            d1 = d2;
        }
        return d1;
    }

    /* bilangan Stirling jenis kedua S(n,k) */
    static int stirling2(int n, int k) {
        if (n < 0 || k < 0 || k > n) { return 0; }
        int[] prev = new int[k + 1];
        prev[0] = 1;
        for (int i = 1; i <= n; i++) {
            int[] cur = new int[k + 1];
            int j = 1;
            while (j <= k && j <= i) {
                cur[j] = prev[j - 1] + j * prev[j];
                j = j + 1;
            }
            prev = cur;
        }
        return prev[k];
    }

    /* bilangan Bell B(n) = Σ S(n,k) */
    static int bell(int n) {
        if (n < 0) { return 0; }
        int total = 0;
        for (int k = 0; k <= n; k++) {
            total = total + stirling2(n, k);
        }
        return total;
    }

    /* ═══════════════ geometri integer ═══════════════ */

    /* kuadrat jarak Euclidean */
    static int distanceSq(int x1, int y1, int x2, int y2) {
        int dx = x2 - x1;
        int dy = y2 - y1;
        return dx * dx + dy * dy;
    }

    /* jarak Manhattan */
    static int manhattan(int x1, int y1, int x2, int y2) {
        return abs(x2 - x1) + abs(y2 - y1);
    }

    static int rectArea(int w, int h) {
        return w * h;
    }

    static int rectPerimeter(int w, int h) {
        return 2 * (w + h);
    }

    /* apakah (a,b,c) sisi segitiga siku-siku (urut sembarang) */
    static boolean isRightTriangle(int a, int b, int c) {
        int x = max3(a, b, c);
        int s1 = 0;
        int s2 = 0;
        if (a == x) { s1 = b; s2 = c; }
        if (b == x) { s1 = a; s2 = c; }
        if (c == x) { s1 = a; s2 = b; }
        return s1 * s1 + s2 * s2 == x * x;
    }

    /* 16·luas² segitiga (rumus Heron, bilangan bulat): sisi a,b,c */
    static int heron16(int a, int b, int c) {
        int p = a + b + c;
        return p * (p - 2 * a) * (p - 2 * b) * (p - 2 * c);
    }

    /* apakah tiga sisi membentuk segitiga valid */
    static boolean isTriangle(int a, int b, int c) {
        if (a <= 0 || b <= 0 || c <= 0) { return false; }
        return a + b > c && a + c > b && b + c > a;
    }
}
