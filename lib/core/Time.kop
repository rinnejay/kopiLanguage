// Time.kop — waktu & tanggal (UTC) di atas builtin Net v1.7.
// epoch = detik Unix (int; batas 2038), monoMs = milidetik monotonik (long).
import Str;

class Time {
    static int epoch() { return Net.time(); }
    static long monoMs() { return Net.mono(); }
    static int sleepMs(int ms) { return Net.sleep(ms); }

    /* [tahun, bulan(1..12), hari(1..31), jam, menit, detik] UTC */
    static int[] civil(int sec) {
        int days = sec / 86400;
        int rem = sec % 86400;
        if (rem < 0) rem = rem + 86400;
        int z = days + 719468;
        int era = z / 146097;
        if (z < 0 && z % 146097 != 0) era = era - 1;
        int doe = z - era * 146097;
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int mp = (5 * doy + 2) / 153;
        int d = doy - (153 * mp + 2) / 5 + 1;
        int m = mp + 3;
        if (mp >= 10) m = mp - 9;
        if (m <= 2) y = y + 1;
        int[] o = new int[6];
        o[0] = y;
        o[1] = m;
        o[2] = d;
        o[3] = rem / 3600;
        o[4] = (rem % 3600) / 60;
        o[5] = rem % 60;
        return o;
    }

    static int weekday(int sec) {
        int days = sec / 86400;
        int w = (days + 4) % 7;
        if (w < 0) w = w + 7;
        return w;                       /* 0=Minggu ... 6=Sabtu */
    }

    static int[] format(int sec) {
        int[] c = civil(sec);
        int[] o = Str.padLeft(Str.fromInt(c[0]), 4, 48);
        o = Str.cat(o, Net.bytes("-"));
        o = Str.cat(o, Str.padLeft(Str.fromInt(c[1]), 2, 48));
        o = Str.cat(o, Net.bytes("-"));
        o = Str.cat(o, Str.padLeft(Str.fromInt(c[2]), 2, 48));
        o = Str.cat(o, Net.bytes(" "));
        o = Str.cat(o, Str.padLeft(Str.fromInt(c[3]), 2, 48));
        o = Str.cat(o, Net.bytes(":"));
        o = Str.cat(o, Str.padLeft(Str.fromInt(c[4]), 2, 48));
        o = Str.cat(o, Net.bytes(":"));
        o = Str.cat(o, Str.padLeft(Str.fromInt(c[5]), 2, 48));
        return o;
    }
}
