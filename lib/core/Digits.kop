// Digits.kop — library standar Kopi: manipulasi digit & basis.
// Catatan: `?`/String belum ada di v1.0, jadi trik idiomatiknya:
//   - digit diolah lewat `n % 10` dan `n / 10`
//   - urutan cetak benar lewat REKURSI (cetak digit setelah memanggil
//     diri-sendiri, sehingga digit paling kanan tercetak terakhir)

import Math;

class Digits {

    // balik urutan digit: 12345 → 54321 (tanda tetap)
    static int reverse(int n) {
        boolean neg = n < 0;
        if (neg) { n = -n; }
        int r = 0;
        while (n > 0) {
            r = r * 10 + n % 10;
            n = n / 10;
        }
        if (neg) { r = -r; }
        return r;
    }

    static int digitSum(int n) {
        if (n < 0) { n = -n; }
        int s = 0;
        while (n > 0) {
            s = s + n % 10;
            n = n / 10;
        }
        return s;
    }

    // hitung berapa digit: 12345 → 5
    static int digitCount(int n) {
        if (n < 0) { n = -n; }
        if (n < 10) { return 1; }
        return 1 + digitCount(n / 10);
    }

    // pangkat tertinggi 10 yang muat: 12345 → 10000
    static int pow10(int n) {
        if (n < 0) { n = -n; }
        int d = 1;
        while (n >= 10) {
            d = d * 10;
            n = n / 10;
        }
        return d;
    }

    // hasil kali semua digit: 12345 → 120 (0 bila ada digit 0)
    static int digitProduct(int n) {
        if (n < 0) { n = -n; }
        if (n == 0) { return 0; }
        int p = 1;
        while (n > 0) {
            p = p * (n % 10);
            n = n / 10;
        }
        return p;
    }

    // apakah angka palindrom (negatif → false)
    static boolean isPalindrome(int n) {
        if (n < 0) { return false; }
        return reverse(n) == n;
    }

    // apakah bilangan Armstrong/Narcissistic: 153 = 1³+5³+3³
    static boolean isArmstrong(int n) {
        if (n < 0) { return false; }
        int k = digitCount(n);
        int m = n;
        int s = 0;
        if (m == 0) { return true; }
        while (m > 0) {
            s = s + Math.pow(m % 10, k);
            m = m / 10;
        }
        return s == n;
    }

    // akar digital (digital root): 0 untuk 0, selain 1..9
    static int digitalRoot(int n) {
        if (n < 0) { n = -n; }
        if (n == 0) { return 0; }
        return 1 + (n - 1) % 9;
    }

    // jumlah kuadrat digit
    static int sumSquareDigits(int n) {
        if (n < 0) { n = -n; }
        int s = 0;
        while (n > 0) {
            int d = n % 10;
            s = s + d * d;
            n = n / 10;
        }
        return s;
    }

    // jumlah pangkat tiga digit
    static int sumCubeDigits(int n) {
        if (n < 0) { n = -n; }
        int s = 0;
        while (n > 0) {
            int d = n % 10;
            s = s + d * d * d;
            n = n / 10;
        }
        return s;
    }

    // cetak n dalam basis 2..10.
    // Basis > 10 belum bisa (butuh karakter 'A'-'F' yang belum tersedia);
    // untuk itu printBase dibatasi dan return tanpa apa-apa keluaran basis.
    static void printBase(int n, int base) {
        if (base < 2 || base > 10) { return; }
        if (n < 0) {
            System.out.print("-");
            n = -n;
        }
        if (n >= base) {
            printBase(n / base, base);   // rekursi dulu → urutan benar
        }
        System.out.print(n % base);
    }
}
