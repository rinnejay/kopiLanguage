// Env.kop — akses environment (v1.24), di atas builtin Net.getenv.

import Str;

class Env {

    static String get(String name) { return Net.getenv(name); }

    static String getOr(String name, String def) {
        String v = Net.getenv(name);
        if (v.length == 0) return def;
        return v;
    }

    static boolean has(String name) { return Net.getenv(name).length > 0; }

    static int getInt(String name, int def) {
        String v = Net.getenv(name);
        if (!Str.isNumber(v)) return def;
        return Str.toInt(v);
    }

    static boolean getBool(String name, boolean def) {
        String v = Str.lower(Net.getenv(name));
        if (v == "1" || v == "true" || v == "yes" || v == "on") return true;
        if (v == "0" || v == "false" || v == "no" || v == "off") return false;
        return def;
    }

    static String home() { return getOr("HOME", "/"); }
    static String user() { return getOr("USER", getOr("LOGNAME", "")); }
    static String shell() { return getOr("SHELL", "/bin/sh"); }
    static String tmpdir() { return getOr("TMPDIR", "/tmp"); }
    static String pwd() { return getOr("PWD", "."); }
    static String lang() { return getOr("LANG", "C"); }
}
