// Log.kop — logging sederhana ke stderr (fd 2) v1.23.
import Time;

class Log {
    static void emit(String level, String tag, String msg) {
        String s = "[" + Time.format(Time.epoch()) + "] ";
        s = s + level + " " + tag + ": " + msg + "\n";
        Net.sendb(2, s);
    }
    static void info(String tag, String msg) { emit("INFO", tag, msg); }
    static void warn(String tag, String msg) { emit("WARN", tag, msg); }
    static void error(String tag, String msg) { emit("ERROR", tag, msg); }
}
