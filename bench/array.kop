/* bench: akses array — menguji bounds-check + load/store elemen */
class Main {
    public static void main(String[] args) {
        int[] a = new int[1000];
        for (int i = 0; i < a.length; i++) a[i] = i;
        long s = 0;
        for (int r = 0; r < 20000; r++) {
            for (int i = 0; i < a.length; i++) s += a[i];
        }
        System.out.println(s);
    }
}
