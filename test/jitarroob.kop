// jitarroob.kop — JIT harus bail dan menyerahkan error batas ke interpreter.
// Keluaran stderr harus sama persis dengan KOPI_NOJIT=1.

class Main {
    static int sum(uint8[] b, int n) {
        int s = 0;
        for (int i = 0; i < n; i++) s = s + b[i];
        return s;
    }

    static void main() {
        uint8[] b = new uint8[8];
        for (int i = 0; i < 8; i++) b[i] = (uint8)i;
        System.out.println(sum(b, 64));      /* indeks 8 di luar batas */
    }
}
