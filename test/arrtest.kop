// uji v1.16: array bertipe long[] dan String[] (slot 64-bit)
class Main {
    public static void main(String[] args) {
        // long[]: alokasi, tulis, baca, length
        long[] a = new long[4];
        a[0] = 1;
        a[1] = 123456789012345L;
        a[2] = a[0] + a[1];
        a[3] = -99;
        System.out.println(a[1]);
        System.out.println(a[2]);
        System.out.println(a[3]);
        System.out.println(a.length);

        // long[]: penjumlahan lewat loop (baca 64-bit berulang)
        long sum = 0;
        for (int i = 0; i < a.length; i = i + 1) {
            sum = sum + a[i];
        }
        System.out.println(sum);

        // String[]: alokasi, tulis, baca, concat, length
        String[] s = new String[3];
        s[0] = "kopi";
        s[1] = "enak";
        s[2] = s[0] + " " + s[1];
        System.out.println(s[0]);
        System.out.println(s[2]);
        System.out.println(s.length);

        // identitas referensi array == / !=
        String[] t = s;
        System.out.println(t == s);
        System.out.println(t != s);

        // elemen long ke fungsi (parameter long)
        System.out.println(gandakan(a[1]));
    }

    static long gandakan(long v) {
        return v * 2;
    }
}
