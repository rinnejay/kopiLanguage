// urltest.kop — uji Url.kop terhadap oracle Python (urllib.parse).
// Dibangkitkan/dibandingkan oleh tools/gen_urlvec.py di test.sh.

import Url;

class Main {
    public static void main(String[] args) {
        System.out.println(Url.encode("a b/c?d=1&e"));
        System.out.println(Url.encode("A-Z_a~z.0"));
        System.out.println(Url.encode("100%"));
        System.out.println(Url.encode(""));
        System.out.println(Url.formEncode("a b+c"));
        System.out.println(Url.decode("a+b%20c"));
        System.out.println(Url.decode("%41%42%zz"));
        System.out.println(Url.pair("q", "a b&c"));
        System.out.println(Url.appendQuery("a=1", "q=a%20b"));

        String u = "http://user@h:8080/p/x?a=1&b=2#frag";
        System.out.println(Url.scheme(u));
        System.out.println(Url.host(u));
        System.out.println(Url.portOf(u, 80));
        System.out.println(Url.path(u));
        System.out.println(Url.query(u));
        System.out.println(Url.fragment(u));
        System.out.println(Url.portOf("http://h/x", 80));

        String base = "http://a/b/c/d;p?q";
        System.out.println(Url.resolve(base, "g:h"));
        System.out.println(Url.resolve(base, "g"));
        System.out.println(Url.resolve(base, "./g"));
        System.out.println(Url.resolve(base, "g/"));
        System.out.println(Url.resolve(base, "/g"));
        System.out.println(Url.resolve(base, "//g"));
        System.out.println(Url.resolve(base, "?y"));
        System.out.println(Url.resolve(base, "g?y"));
        System.out.println(Url.resolve(base, "#s"));
        System.out.println(Url.resolve(base, "g#s"));
        System.out.println(Url.resolve(base, ""));
        System.out.println(Url.resolve(base, ".."));
        System.out.println(Url.resolve(base, "../g"));
        System.out.println(Url.resolve(base, "../../g"));

        System.out.println(Url.normalize("/a/b/../c/./d"));
        System.out.println(Url.normalize("/x/../../y"));

        System.out.println(Url.ip4("127.0.0.1"));
        System.out.println(Url.ip4("999.1.1.1"));
        System.out.println(Url.ip4("a.b.c.d"));
    }
}
