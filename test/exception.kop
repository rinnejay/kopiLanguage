/* exception.kop — regresi throw / try / catch (v1.49).
 *
 * Yang diuji:
 *  - throw dari metode yang dalam (3 frame) ditangkap try di pemanggil;
 *  - catch boleh melempar lagi (rethrow) ke handler luar;
 *  - try bersarang, variabel lokal yang diubah di dalam try tetap terlihat
 *    di catch (lokal tidak di-register-kan pada metode bertry);
 *  - return / break / continue dari dalam try menutup handler dengan benar
 *    (kalau tidak, throw berikutnya akan melompat ke frame mati);
 *  - throw nilai int (bukan hanya String);
 *  - callee-saved pemanggil utuh setelah throw melompati beberapa frame.
 */

class Main {
    static void lapis3(int n) {
        if (n < 0) throw "negatif";
        System.out.println(n);
    }

    static void lapis2(int n) { lapis3(n); }

    static void lapis1(int n) {
        try {
            lapis2(n);
        } catch (String e) {
            System.out.println(e);
            throw "dibungkus";
        }
    }

    static int cari(int[] a, int x) {
        for (int i = 0; i < a.length; i++) {
            try {
                if (a[i] == x) return i;
            } catch (String e) {
                return -1;
            }
        }
        return -2;
    }

    static int jumlahLewat(int[] a) {
        int s = 0;
        for (int i = 0; i < a.length; i++) {
            try {
                if (i == 1) continue;
                if (i == 4) break;
                s += a[i];
            } catch (String e) {
                s = -1;
            }
        }
        return s;
    }

    public static void main(String[] args) {
        try {
            lapis1(-7);
        } catch (String e) {
            System.out.println("luar: " + e);
        }

        try {
            lapis1(3);
        } catch (String e) {
            System.out.println("luar: " + e);
        }

        int[] a = new int[5];
        for (int i = 0; i < a.length; i++) a[i] = i + 1;
        System.out.println(cari(a, 4));      // 3
        System.out.println(cari(a, 99));     // -2
        System.out.println(jumlahLewat(a));  // 1+3+4 = 8

        int x = 1;
        try {
            x = 5;
            try {
                throw "dalam";
            } catch (String e) {
                System.out.println(e + "!");
                x = 9;
            }
            System.out.println(x);           // 9
        } catch (String e) {
            System.out.println("luar " + e);
        }

        try {
            throw 42;                        // exception bertipe int
        } catch (int kode) {
            System.out.println(kode + 1);    // 43
        }

        int a1 = 1, b1 = 2, c1 = 3, d1 = 4, e1 = 5, f1 = 6, g1 = 7, h1 = 8;
        try {
            lapis2(-1);                      // throw dari 3 frame di bawah
        } catch (String e) {
            System.out.println(a1 + b1 + c1 + d1 + e1 + f1 + g1 + h1);  // 36
        }

        System.out.println("selesai");
    }
}
