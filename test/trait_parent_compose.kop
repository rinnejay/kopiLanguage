// v1.47: komposisi trait — B::foo() memanggil implementasi A::foo().
trait A {
    void foo() {
        System.out.println("A.foo");
    }
}

trait B {
    void foo() {
        System.out.println("B.foo sebelum");
        A::foo();
        System.out.println("B.foo sesudah");
    }
}

class C : A, B {
    void foo() {
        System.out.println("C.foo sebelum");
        B::foo();
        System.out.println("C.foo sesudah");
    }
}

class Main {
    public static void main(String[] args) {
        C c = new C();
        c.foo();
    }
}
