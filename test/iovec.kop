// iovec.kop — uji lib/io (Reader, Writer) + Uuid + Csv (v1.29).
import Reader;
import Writer;
import Uuid;
import Csv;
import Cipher;
import File;

class Main {
    public static void main(String[] args) {
        // ── Reader: baris demi baris ──────────────────────────────
        Reader r = Reader.open("test/data/berkas.txt");
        System.out.println(r.valid());
        System.out.println(r.readLine());
        System.out.println(r.readLine());
        System.out.println(r.readLine());
        System.out.println(r.readLine());
        r.close();

        // ── Reader: seluruh isi ────────────────────────────────────
        Reader r2 = Reader.open("test/data/berkas.txt");
        String all = r2.readAll();
        System.out.println(all.length);
        System.out.println(Cipher.hexenc(Net.strbytes(all)));
        r2.close();

        // ── Reader: sebagian byte ──────────────────────────────────
        Reader r3 = Reader.open("test/data/berkas.txt");
        int[] b5 = r3.readBytes(5);
        System.out.println(b5.length);
        System.out.println(Cipher.hexenc(b5));
        r3.close();

        // ── Reader: file tidak ada ─────────────────────────────────
        Reader r4 = Reader.open("test/data/tidak-ada.txt");
        System.out.println(r4.valid());

        // ── Writer: tulis lalu baca balik ──────────────────────────
        Writer w = Writer.open("out-io-tmp.txt");
        w.writeLine("halo");
        w.write("dunia");
        w.writeLine("");
        w.close();
        Reader r5 = Reader.open("out-io-tmp.txt");
        String isi = r5.readAll();
        r5.close();
        System.out.println(isi.length);
        System.out.println(Cipher.hexenc(Net.strbytes(isi)));
        File.remove("out-io-tmp.txt");

        // ── Uuid ────────────────────────────────────────────────────
        String u = Uuid.v4();
        System.out.println(u.length);
        System.out.println(Uuid.valid(u));
        System.out.println(Uuid.version(u));
        System.out.println(Uuid.valid("bukan-uuid"));
        System.out.println(Uuid.nil());
        System.out.println(Uuid.valid(Uuid.nil()));

        // ── Csv ─────────────────────────────────────────────────────
        String[] row = Csv.parseRow("a,\"b,c\",\"d\"\"e\",f");
        System.out.println(row.length);
        for (int i = 0; i < row.length; i++) System.out.println(row[i]);
        System.out.println(Csv.formatRow(row));
        System.out.println(Csv.countRows("a,b\nc,d\n"));
        String[] ls = Csv.lines("x\ny\n");
        System.out.println(ls.length);
        int[] rl = Csv.rowLengths("a,b\nc,d,e\n");
        System.out.println(rl[0]);
        System.out.println(rl[1]);
        System.out.println(Csv.parseRow("").length);
        System.out.println(Csv.parseRow("satu").length);
    }
}
