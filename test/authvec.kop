// authvec.kop — PBKDF2 / JWT / Session / Auth (v1.10.0).
import Bytes;
import Cipher;
import Pbkdf2;
import Jwt;
import MapStr;
import Session;
import Auth;

class Main {
    public static void main(String[] args) {
        System.out.println(Cipher.hexenc(Pbkdf2.sha256(Net.bytes("password"), Net.bytes("salt"), 1, 32)));
        System.out.println(Cipher.hexenc(Pbkdf2.sha256(Net.bytes("password"), Net.bytes("salt"), 2, 32)));
        System.out.println(Cipher.hexenc(Pbkdf2.sha256(Net.bytes("password"), Net.bytes("salt"), 4096, 32)));
        System.out.println(Cipher.hexenc(Pbkdf2.sha256(
            Net.bytes("passwordPASSWORDpassword"),
            Net.bytes("saltSALTsaltSALTsaltSALTsaltSALTsalt"), 4096, 40)));

        String secret = "rahasia";
        String token = Jwt.sign("{\"sub\":\"budi\",\"n\":1}", secret);
        System.out.println(token);
        int[] out = new int[64];
        System.out.println(Jwt.verify(token, secret, out));
        System.out.println(Jwt.verify(token, "salah", out));
        System.out.println(Jwt.verify("abc", secret, out));
        System.out.println(Jwt.payloadOf(token));

        int[] ids = MapStr.make(16, 256);
        int[] exps = MapStr.make(16, 256);
        System.out.println(Session.put(ids, exps, "id1", 42, 10, 100));
        System.out.println(Session.get(ids, exps, "id1", 105));
        System.out.println(Session.get(ids, exps, "id1", 111));
        Session.put(ids, exps, "id2", 43, 10, 100);
        System.out.println(Session.sweep(ids, exps, 200));
        System.out.println(Session.get(ids, exps, "id2", 200));

        String hdr = "Basic " + Cipher.b64enc("budi:rahasia");
        System.out.println(Auth.checkBasic(hdr, "budi", "rahasia"));
        System.out.println(Auth.checkBasic(hdr, "budi", "salah"));
        System.out.println(Auth.bearer("Bearer tok.abc"));
        System.out.println(Auth.scheme("Bearer tok.abc"));
        System.out.println(Auth.challenge("admin"));
    }
}
